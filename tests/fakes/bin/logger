#!/usr/bin/env python3
"""Fake util-linux logger reading stdin: append each line to
$FAKE_NET_DIR/journal.log as "IDENT[PRIORITY,id=ID] line".
$FAKE_NET_DIR/log.fail = logger makes it fail at once."""

import os
import sys

d = os.environ.get("FAKE_NET_DIR", "/tmp/opencode/fakenet")
try:
    if open(os.path.join(d, "log.fail")).read().strip() == "logger":
        sys.exit("logger: socket /dev/log: No such file or directory (fake)")
except OSError:
    pass
a = sys.argv[1:]
ident = a[a.index("-t") + 1]
prio = a[a.index("-p") + 1] if "-p" in a else "user.notice"
pid = [x.split("=", 1)[1] for x in a if x.startswith("--id=")]
with open(os.path.join(d, "journal.log"), "a", buffering=1) as f:
    for line in sys.stdin:
        f.write("%s[%s,id=%s] %s" % (ident, prio, pid[0] if pid else "", line))
