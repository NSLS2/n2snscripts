#!/usr/bin/env python3
"""Fake systemd-cat: append each line of stdin to $FAKE_NET_DIR/journal.log as
"IDENT[PRIORITY] line".  Only `-t IDENT -p PRIORITY` without a command is
supported.  $FAKE_NET_DIR/log.fail = systemd-cat makes it fail at once."""

import os
import sys

d = os.environ.get("FAKE_NET_DIR", "/tmp/opencode/fakenet")
try:
    if open(os.path.join(d, "log.fail")).read().strip() == "systemd-cat":
        sys.exit("Failed to create stream fd: No such file or directory (fake)")
except OSError:
    pass
a = sys.argv[1:]
ident = a[a.index("-t") + 1]
rest = a[a.index("-t") + 2 :]
if rest[:1] == ["-p"]:
    prio, rest = rest[1], rest[2:]
else:
    prio = "info"
if rest:
    os.execvp(rest[0], rest)
with open(os.path.join(d, "journal.log"), "a", buffering=1) as f:
    for line in sys.stdin:
        f.write("%s[%s] %s" % (ident, prio, line))
