#!/usr/bin/env bash
# bwcodex — Launch OpenAI Codex CLI inside a bubblewrap (bwrap) sandbox.
#
# Requires: bwrap >= 0.4.0 (RHEL 8)
#   - 0.4.0: base functionality
#   - 0.6.3+: bind over ro-bind (fallback: skip binary masking)
#
# Two approved auth paths are supported (configured in ~/.codex/config.toml):
#   - Hermes (AIFAPIM) routing — provider block points at
#       https://${AIFAPIM_HOST}/openai/v1 with x-api-key header;
#       wrapper plumbs AIFAPIM_HOST + AIFAPIM_API_KEY through.  Set
#       OPENAI_API_KEY=dummy on the host or rely on the wrapper default.
#   - BNL ITD ChatGPT subscription — `codex login` OAuth flow persists
#       tokens to ~/.codex/auth.json.  Run once with --init-auth to make
#       that file persist across sandbox invocations.
#
# Note: Codex CLI also enforces its own inner Landlock-based sandbox for
# agent tool calls.  The outer bwrap here is complementary — it scopes
# the entire Codex process tree, not just agent-issued commands.
#
# The sandbox provides filesystem isolation:
#   - Current directory: read-write
#   - Codex home (~/.codex or $CODEX_HOME): tmpfs (ephemeral by default)
#     - sessions/: bind-mounted read-write (for `codex resume` / `codex fork`)
#     - log/: bind-mounted read-write (RUST_LOG / opt-in plaintext logs)
#     - history.jsonl: bind-mounted read-write (prompt history)
#     - config.toml: by default, opened as a file descriptor and passed to
#         bwrap via --file so Codex can persist project-trust grants for the
#         session without touching the host file (the temp copy is unlinked
#         immediately after opening; no cleanup needed on exit).
#         With --persist-config, the host config.toml is
#         bind-mounted RW so writes persist across sessions at the cost of
#         weaker isolation.  Either the user file or the system file
#         (/etc/codex/config.toml) is sufficient for fail-fast.
#     - AGENTS.md: bind-mounted read-only (if it exists)
#     - packages/: tmpfs; managed daemon package copied from the CLI on each run
#     - app-server-daemon/settings.json: ephemeral, disables daemon auto-update
#     - auth.json: bind-mounted read-write only if it already exists on host;
#         --init-auth creates a {} stub for first-time ChatGPT-login setup
#     - Everything else (tmp/, state.toml, features/, ...): tmpfs, discarded on exit
#   - Authoring directories (~/.codex/skills, ~/.codex/prompts): read-write,
#     always created on the host, so definitions authored in the sandbox
#     persist; ~/.agents/skills: read-write (if present).  Skills symlinked in
#     from elsewhere (e.g. a shared skills repository) work too
#   - /etc/codex/config.toml: system-wide provider/defaults config (if
#       present); bind-mounted read-only.  Codex layers user config on
#       top of this file.
#   - /etc/codex/requirements.toml: admin-enforced restrictions (if
#       present); bind-mounted read-only.  Users cannot loosen these.
#   - Codex CLI package (including metadata and resources): read-only
#   - Git config + includes: read-only
#   - Pixi cache: read-write
#   - Pixi config: read-only
#   - ccache config: read-only
#   - ccache cache: read-write
#   - npm config: read-only
#   - npm cache: read-write
#   - System and user binaries: read-only
#   - SSH binaries: masked (ssh, scp, sftp, ssh-agent, etc.)
#   - Network tools: masked (telnet, nc/ncat, socat, rsync, rsh)
#   - Kerberos tools: masked (kinit, klist, kdestroy, kswitch)
#   - Privilege escalation: masked (sudo, su, pkexec)
#   - Namespace tools: masked (nsenter, unshare, chroot)
#   - Keyring tools: masked (keyctl)
#   - SSH/GPG agent env vars: stripped
#   - ~/.bashrc and other shell rc files: not mounted
#
# Usage:
#   bwcodex [bwcodex-options] [codex arguments...]
#   bwcodex --help
#
# Options:
#   --help, -h      Show this help (wrapper options + codex's own help).
#   --dry-run       Print the bwrap command that would be executed without running it.
#   --exec CMD      Run CMD inside the sandbox instead of codex.
#                   Useful for running one-off commands, scripts, or diagnostic tools
#                   inside the fully-configured sandbox environment.
#   --init-auth     Create ~/.codex/auth.json on the host so that ChatGPT-login
#                   OAuth tokens persist across sessions.  Only meaningful for the
#                   BNL ITD ChatGPT subscription auth path; has no effect for
#                   Hermes-routed setups.  On shared accounts, do NOT use this
#                   flag — tokens will be ephemeral by default.
#   --persist-config Bind ~/.codex/config.toml read-write into the sandbox so
#                   writes persist across sessions.  Default: config.toml is
#                   copied to a per-session staging file; host file is unchanged.
#   --debug         Enable verbose Codex logging (sets RUST_LOG=debug).
#   --new-session   Force bwrap --new-session even on kernels with the TIOCSTI cap
#                   guard.  Detaches the controlling tty for stricter isolation at the
#                   cost of SIGWINCH (terminal resize) propagation.
#   --n2c-token NAME  Mount the N2C access token NAME read-only (for NSLS-II API
#                   skills).  May be repeated; `all` mounts every token present.
#                   Off by default.  The refresh token is never mounted.
#   --ro-path PATH  Mount PATH read-only into the sandbox.  May be repeated to
#                   accumulate multiple paths.  Dangerous paths are blocked:
#                   $HOME and ancestors, ~/.ssh, ~/.gnupg, ~/.aws, ~/.kube,
#                   ~/.docker, ~/.netrc, ~/.pypirc, ~/.rattler, ~/.yarnrc,
#                   ~/.yarnrc.yml, ~/.yarn, ~/.config/gh,
#                   $XDG_DATA_HOME/uv/credentials, /root, /etc/shadow,
#                   /etc/sudoers{,.d}.
#   --rw-path PATH  Mount PATH read-write into the sandbox.  May be repeated to
#                   accumulate multiple paths.  Same blocked-path rules as --ro-path.
#                   A nested --ro-path/--rw-path overrides the one it sits under,
#                   so `--rw-path DIR --ro-path DIR/sub` protects DIR/sub.
#   --no-sandbox-context
#                   Do not generate the sandbox context file (see below).
#
# Sandbox context: a short markdown file describing this sandbox (what is
# mounted read-only or read-write, what is lost at exit, which tools are
# disabled) is built from the final mounts and mounted read-only at
# ~/.sandbox/AGENTS.md, and BWRAP_SANDBOX / BWRAP_SANDBOX_CONTEXT are set.
# Codex loads it through -c developer_instructions=..., which is sent as a
# separate message and leaves AGENTS.md alone (verified with 0.164.0); skipped,
# with a warning, when a config.toml or the command line already sets it.
# Not added to a --exec command.

set -euo pipefail

# Source the shared sandbox library.
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../lib/bwrap_sandbox_lib.sh
source "${SCRIPT_DIR}/../lib/bwrap_sandbox_lib.sh"

# ═══════════════════════════════════════════════════════════════════
# Tool-specific state
# ═══════════════════════════════════════════════════════════════════

INIT_AUTH=0
DEBUG_MODE=0
PERSIST_CONFIG=0
FORWARD_GH_TOKENS=0

# ═══════════════════════════════════════════════════════════════════
# Tool-specific functions
# ═══════════════════════════════════════════════════════════════════

parse_wrapper_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help | -h)
                SHOW_HELP=1
                shift
                ;;
            --dry-run)
                DRY_RUN=1
                shift
                ;;
            --exec)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --exec requires a command argument." >&2
                    exit 1
                fi
                # shellcheck disable=SC2034  # read by bwrap_resolve_tool in the library
                TEST_CMD="$2"
                shift 2
                ;;
            --init-auth)
                INIT_AUTH=1
                shift
                ;;
            --persist-config)
                PERSIST_CONFIG=1
                shift
                ;;
            --debug)
                DEBUG_MODE=1
                shift
                ;;
            --github-tokens)
                FORWARD_GH_TOKENS=1
                shift
                ;;
            --new-session)
                # shellcheck disable=SC2034  # consumed by sourced bwrap_sandbox_lib.sh (sandboxed_exec)
                FORCE_NEW_SESSION=1
                shift
                ;;
            --n2c-token)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --n2c-token requires a token name or 'all'." >&2
                    exit 1
                fi
                add_n2c_token "$2"
                shift 2
                ;;
            --no-sandbox-context)
                # shellcheck disable=SC2034  # consumed by sourced bwrap_sandbox_lib.sh
                SANDBOX_CONTEXT_ENABLED=0
                shift
                ;;
            --ro-path)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --ro-path requires a path argument." >&2
                    exit 1
                fi
                EXTRA_RO_PATHS+=("$2")
                shift 2
                ;;
            --rw-path)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --rw-path requires a path argument." >&2
                    exit 1
                fi
                EXTRA_RW_PATHS+=("$2")
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done
    # shellcheck disable=SC2034  # consumed by library's print_dry_run/launch_sandbox
    TOOL_ARGS=("$@")
}

# Find the absolute path to the codex binary on the host so we do
# not depend on PATH lookup inside the sandbox.
# Sets globals: _TOOL_BIN, _TOOL_CMD
show_help() {
    cat << 'HELP_EOF'
bwcodex — OpenAI Codex CLI inside a bubblewrap sandbox

Wrapper options (consumed before codex sees the command line):
  -h, --help      Show this message followed by codex's own help.
  --dry-run       Print the bwrap command that would be run, then exit.
  --exec CMD      Run CMD inside the fully-configured sandbox instead of codex.
                  Use this to run scripts, diagnostic tools, or any command with
                  the same filesystem isolation and environment as codex itself.
                  Example: bwcodex --exec bash
                           bwcodex --exec bash -c 'env | sort'
                  CMD itself is split on whitespace; pass arguments that need
                  quoting as separate words after it, as above.
  --init-auth     Create ~/.codex/auth.json on the host so that ChatGPT-login
                  OAuth tokens persist across sessions.  Only meaningful for the
                  BNL ITD ChatGPT subscription auth path; has no effect for
                  Hermes-routed setups.  On shared accounts, do NOT use this
                  flag — tokens will be ephemeral by default.
  --persist-config Bind ~/.codex/config.toml read-write into the sandbox so
                  Codex can persist project trust decisions and other
                  config.toml mutations across sessions.  WARNING: this
                  weakens sandbox isolation — a compromised Codex could
                  modify provider URLs, auth headers, or other config keys.
                  Concurrent --persist-config sessions may race on writes.
                  Without this flag (the default), config.toml is copied to
                  a per-session staging file and any writes are discarded
                  on exit.
  --debug         Enable verbose Codex logging (sets RUST_LOG=debug).
  --new-session   Force bwrap to call setsid(2), detaching the sandbox from the
                  controlling terminal.  This is the default on older kernels
                  (< 5.14); on newer kernels we omit it so that SIGWINCH (terminal
                  resize) propagates from tmux/screen.  Use this flag to opt back
                  into stricter terminal isolation when SIGWINCH is not important.
  --n2c-token NAME
                  Mount the N2C access token NAME (read-only) so skills inside
                  the sandbox can call NSLS-II APIs, for example observability,
                  docs or epics.  May be repeated; `--n2c-token all` mounts every
                  token present.  Off by default: no token is mounted unless
                  asked for.  Tokens are written on the host by `n2c-token`
                  (run `n2c-token login` first); the refresh token is never
                  mounted.  A missing token only warns.
  --ro-path PATH  Mount PATH (file or directory) read-only into the sandbox.
                  May be repeated to accumulate multiple extra paths.
                  Blocked: $HOME and ancestors, ~/.ssh, ~/.gnupg, ~/.aws,
                  ~/.kube, ~/.docker, ~/.netrc, ~/.pypirc, ~/.rattler,
                  ~/.yarnrc, ~/.yarnrc.yml, ~/.yarn, ~/.config/gh,
                  $XDG_DATA_HOME/uv/credentials, /root, /etc/shadow,
                  /etc/sudoers{,.d}.
                  Symlinks are resolved before the safety check is applied.
  --rw-path PATH  Mount PATH (file or directory) read-write into the sandbox.
                  Same blocked-path rules as --ro-path.  May be repeated.
                  --ro-path/--rw-path may nest: a nested path overrides the one
                  it sits under, so `--rw-path DIR --ro-path DIR/sub` keeps DIR
                  writable but DIR/sub read-only.
  --github-tokens Forward any GH_TOKEN_* environment variables into the
                  sandbox so the agent can authenticate the gh(1) CLI.
                  Off by default.  When set, use per-command token selection:
                    GH_TOKEN="$GH_TOKEN_NSLS2" gh pr list -R NSLS2/repo
                    GH_TOKEN="$GH_TOKEN_PERSONAL" gh issue list -R user/repo
  --no-sandbox-context
                  Do not tell the agent about the sandbox.  By default a short
                  description of what is mounted (read-only or read-write), what
                  is lost at exit and which tools are disabled is mounted at
                  ~/.sandbox/AGENTS.md and passed to Codex as
                  developer_instructions (AGENTS.md is kept).
                  Use --dry-run to see it.

All other arguments are passed through to codex unchanged.

Authentication:
  Two paths are supported:
    - Hermes (AIFAPIM):  set AIFAPIM_API_KEY (e.g. via `load_dotenv`) and
                         keep OPENAI_API_KEY=dummy.  See ~/.codex/config.toml
                         for the [model_providers.nsls2-hermes] block.
    - ChatGPT login:     run `bwcodex --init-auth` once, then `bwcodex` and
                         `codex login` to populate ~/.codex/auth.json.

HELP_EOF
    # Delegate to codex --help inside the sandbox so the user sees the full
    # codex option set in the same invocation.
    bwrap_show_tool_help codex
}

resolve_codex_paths() {
    # Codex home: config, auth, sessions, logs, history, skills.
    # Override: CODEX_HOME env var.  Codex CLI does NOT use XDG dirs.
    CODEX_HOME_DIR="${CODEX_HOME:-${_HOME}/.codex}"

    CODEX_CONFIG_FILE="${CODEX_HOME_DIR}/config.toml"
    CODEX_AGENTS_FILE="${CODEX_HOME_DIR}/AGENTS.md"
    CODEX_AUTH_FILE="${CODEX_HOME_DIR}/auth.json"
    CODEX_SESSIONS_DIR="${CODEX_HOME_DIR}/sessions"
    CODEX_LOG_DIR="${CODEX_HOME_DIR}/log"
    CODEX_SKILLS_DIR="${CODEX_HOME_DIR}/skills"
    CODEX_PROMPTS_DIR="${CODEX_HOME_DIR}/prompts"
    CODEX_HISTORY_FILE="${CODEX_HOME_DIR}/history.jsonl"
    CODEX_DAEMON_SETTINGS_FILE="${CODEX_HOME_DIR}/app-server-daemon/settings.json"

    # Validate the user-controllable root directory once here so that all
    # sub-path mounts derived from it are implicitly covered.
    _check_dir_safe "${CODEX_HOME_DIR}" "CODEX_HOME"
}

# Ensure writable directories and files exist on host.
ensure_host_dirs() {
    mkdir -p "${CODEX_HOME_DIR}" \
             "${CODEX_SESSIONS_DIR}" \
             "${CODEX_LOG_DIR}"
    touch "${CODEX_HISTORY_FILE}"
}

# Fail fast if no config.toml exists.  Codex requires a config.toml to
# select a provider; running bwcodex without one would produce a confusing
# error from Codex itself.  Either the system-wide file (deployed by
# ansible on managed hosts) or the user file is sufficient — Codex layers
# the user file on top of the system file.
SYSTEM_CODEX_CONFIG_FILE="/etc/codex/config.toml"
SYSTEM_CODEX_REQUIREMENTS_FILE="/etc/codex/requirements.toml"
check_codex_config() {
    if [[ ! -r "${SYSTEM_CODEX_CONFIG_FILE}" ]] && [[ ! -r "${CODEX_CONFIG_FILE}" ]]; then
        printf 'Error: Codex requires a config.toml to select a provider.\n' >&2
        printf '       Checked:\n' >&2
        printf '         %s (system-wide; deployed by ansible)\n' "${SYSTEM_CODEX_CONFIG_FILE}" >&2
        printf '         %s   (user)\n' "${CODEX_CONFIG_FILE}" >&2
        printf '       Create at least one — see\n' >&2
        printf '       https://docs.nsls2.bnl.gov/docs/how-to/codex.html\n' >&2
        exit 2
    fi
}

# ── Codex authoring directories (read-write, persistent) ──────────
# skills/ and prompts/ hold user-authored markdown definitions.  They are
# created on the host when missing and mounted read-write so the agent can
# create and edit them from inside the sandbox.  ~/.agents/skills is an
# additional skills location, mounted only if it already exists.  Must run
# AFTER build_codex_home_mount (the home is a tmpfs that would hide them).
build_codex_authoring_mounts() {
    build_authoring_dir_mounts skill  "${CODEX_SKILLS_DIR}"
    build_authoring_dir_mounts prompt "${CODEX_PROMPTS_DIR}"
    build_personal_authoring_mounts skill "${_HOME}/.agents/skills"
}

# ── Managed Codex skills (read-only) ──────────────────────────────
# Resolve the fixed administrator-managed alias before binding it at the
# location Codex discovers.  This is deliberately not a --ro-path mount.
build_managed_skills() {
    [[ -d /etc/codex/skills && -r /etc/codex/skills ]] || return 0
    BWRAP_ARGS+=(--dir /etc/codex)
    build_managed_ro_bind /etc/codex/skills /etc/codex/skills
}

# ── Codex home (ephemeral tmpfs + selective persistence) ─────────
# Mount the home dir as ephemeral tmpfs, then selectively bind-mount
# the files and directories that must persist across sessions.
#
# auth.json is only bind-mounted if it already exists on the host.
# If absent, codex creates it inside the tmpfs — the token is usable
# for the session but discarded on exit.  This is the desired
# behaviour for shared accounts.  On a personal account using
# ChatGPT login, run with --init-auth once to bootstrap persistent auth.
build_codex_home_mount() {
    # Create intermediate --dir entries if CODEX_HOME_DIR is nested under
    # $HOME.  CODEX_HOME_DIR is the tmpfs mount point, so only its ancestors
    # are pre-created.
    _emit_home_intermediate_dirs "${CODEX_HOME_DIR}"

    BWRAP_ARGS+=(--tmpfs "${CODEX_HOME_DIR}")

    # Persistent read-write directories
    local _subdir
    for _subdir in sessions log; do
        BWRAP_ARGS+=(--bind "${CODEX_HOME_DIR}/${_subdir}" "${CODEX_HOME_DIR}/${_subdir}")
    done

    # Persistent read-write files
    BWRAP_ARGS+=(--bind "${CODEX_HISTORY_FILE}" "${CODEX_HISTORY_FILE}")

    # System-wide config (Codex layers user config on top of it).  Mounted
    # read-only — users cannot mutate the institutional defaults from
    # inside the sandbox.
    if [[ -f "${SYSTEM_CODEX_CONFIG_FILE}" ]]; then
        BWRAP_ARGS+=(--ro-bind "${SYSTEM_CODEX_CONFIG_FILE}" "${SYSTEM_CODEX_CONFIG_FILE}")
    fi

    # System-wide admin-enforced restrictions (e.g. allowed_sandbox_modes).
    # Always read-only; users cannot loosen institutional restrictions.
    if [[ -f "${SYSTEM_CODEX_REQUIREMENTS_FILE}" ]]; then
        BWRAP_ARGS+=(--ro-bind "${SYSTEM_CODEX_REQUIREMENTS_FILE}" "${SYSTEM_CODEX_REQUIREMENTS_FILE}")
    fi

    # User config.toml mount strategy (see file header):
    #   - Default: open a temporary copy of config.toml as an fd and pass it
    #     to bwrap via --file.  bwrap creates a plain (writable) file in the
    #     sandbox tmpfs from the fd content, so Codex can persist project-trust
    #     grants for the session without touching the host file.  The temp
    #     file is unlinked immediately after the fd is opened, so no cleanup
    #     is needed on exit — the fd holds the only reference and closes when
    #     bwrap exec's into the tool.
    #   - --persist-config: bind host config.toml RW so writes persist.
    # If the user file does not exist (managed host using only system
    # config), skip the user mount entirely.
    if [[ -f "${CODEX_CONFIG_FILE}" ]]; then
        if [[ "${PERSIST_CONFIG}" -eq 1 ]]; then
            BWRAP_ARGS+=(--bind "${CODEX_CONFIG_FILE}" "${CODEX_CONFIG_FILE}")
        elif [[ "${DRY_RUN}" -eq 1 ]]; then
            # --dry-run stages nothing on the host, and a real fd number could
            # not be reproduced by copy-paste: print a placeholder instead.
            BWRAP_ARGS+=(--file "<config-fd>" "${CODEX_CONFIG_FILE}")
        else
            local _config_fd _staged_config
            _staged_config="$(mktemp --tmpdir bwcodex-config.XXXXXX.toml)"
            # Plain cp (not cp -p) keeps mktemp's 0600 mode; -p would apply
            # the source's mode (typically 0644), leaving a world-readable
            # copy in the shared temp directory until the unlink below.
            cp "${CODEX_CONFIG_FILE}" "${_staged_config}"
            # Open the copy as an fd then immediately unlink it.  The kernel
            # keeps the data alive via the open fd; the filename disappears
            # from /tmp so there is nothing to clean up on exit or signal.
            exec {_config_fd}< "${_staged_config}"
            rm -f "${_staged_config}"
            BWRAP_ARGS+=(--file "${_config_fd}" "${CODEX_CONFIG_FILE}")
        fi
    fi

    if [[ -e "${CODEX_AGENTS_FILE}" ]]; then
        BWRAP_ARGS+=(--ro-bind "${CODEX_AGENTS_FILE}" "${CODEX_AGENTS_FILE}")
    fi

    # Keep the managed daemon package in tmpfs.  The complete CLI package
    # mounted by build_codex_bin_mount seeds it on each launch.  Disable the
    # daemon's updater before Codex starts so it does not fetch a newer copy.
    BWRAP_ARGS+=(--perms 0700 --dir "${CODEX_HOME_DIR}/app-server-daemon")
    if [[ "${DRY_RUN}" -eq 1 ]]; then
        BWRAP_ARGS+=(--perms 0600 --file "<daemon-settings-fd>" "${CODEX_DAEMON_SETTINGS_FILE}")
    else
        local _settings_fd _staged_settings
        _staged_settings="$(mktemp --tmpdir bwcodex-daemon-settings.XXXXXX.json)"
        printf '{"updater":{"autoUpdateEnabled":false}}\n' > "${_staged_settings}"
        exec {_settings_fd}< "${_staged_settings}"
        rm -f "${_staged_settings}"
        BWRAP_ARGS+=(--perms 0600 --file "${_settings_fd}" "${CODEX_DAEMON_SETTINGS_FILE}")
    fi

    # auth.json: only persist if it already exists on the host.
    # Use --init-auth on first run to bootstrap persistent ChatGPT-login auth.
    # File creation is skipped on --dry-run to keep that mode side-effect-free.
    if [[ "${INIT_AUTH}" -eq 1 ]] && [[ ! -f "${CODEX_AUTH_FILE}" ]]; then
        if [[ "${DRY_RUN}" -eq 0 ]]; then
            ( umask 077 && printf '{}\n' > "${CODEX_AUTH_FILE}" )
            echo "Created ${CODEX_AUTH_FILE} — auth tokens will persist after this session." >&2
        fi
    fi
    if _persist_bind_wanted "${CODEX_AUTH_FILE}"; then
        BWRAP_ARGS+=(--bind "${CODEX_AUTH_FILE}" "${CODEX_AUTH_FILE}")
    fi
}

# ── SSL_CERT_FILE (read-only) ────────────────────────────────────
# Codex honours SSL_CERT_FILE, but forwarding only the variable is not
# enough: a bundle under $HOME (or anywhere else not mounted) is absent in
# the sandbox and TLS fails.  Mount the canonical file read-only and point
# SSL_CERT_FILE at it; refuse with a warning (and do not forward) when it
# does not resolve to a readable file or resolves into a blocked location.
build_ssl_cert_file_mount() {
    [[ -n "${SSL_CERT_FILE:-}" ]] || return 0
    local _canon
    _canon="$(readlink -f -- "${SSL_CERT_FILE}" 2> /dev/null || true)"
    if [[ -z "${_canon}" || ! -f "${_canon}" || ! -r "${_canon}" ]]; then
        echo "Warning: SSL_CERT_FILE=${SSL_CERT_FILE} is not a readable file; not forwarding it." >&2
        return 0
    fi
    if _bwrap_path_blocked "${_canon}"; then
        echo "Warning: SSL_CERT_FILE=${SSL_CERT_FILE} resolves into a blocked location; not forwarding it." >&2
        return 0
    fi
    # Bound even when a parent tree is already mounted (harmless there), so
    # a file under a sandbox tmpfs such as /tmp is still provided.
    _emit_home_intermediate_dirs "${_canon%/*}" inclusive
    BWRAP_ARGS+=(--ro-bind "${_canon}" "${_canon}")
    BWRAP_ARGS+=(--setenv SSL_CERT_FILE "${_canon}")
}

# ── Codex env vars ───────────────────────────────────────────────
# Pass through AIFAPIM_* (Hermes routing) and the documented Codex
# env vars; default OPENAI_API_KEY to "dummy" if unset so the Codex
# provider preflight passes for Hermes-routed setups (the real auth
# is the x-api-key header sourced from AIFAPIM_API_KEY via the
# provider's env_http_headers).
build_codex_env() {
    # AIFAPIM gateway config
    pass_through_if_set AIFAPIM_HOST
    pass_through_if_set AIFAPIM_API_KEY

    # OPENAI_API_KEY is required by Codex's provider preflight.  Hermes
    # ignores the Authorization header (real auth is x-api-key), so a
    # literal "dummy" value is safe and convenient.
    if [[ -z "${OPENAI_API_KEY:-}" ]]; then
        BWRAP_ARGS+=(--setenv OPENAI_API_KEY "dummy")
    else
        pass_through_if_set OPENAI_API_KEY
    fi

    # Non-CODEX_* vars that Codex consults.
    build_ssl_cert_file_mount
    pass_through_if_set RUST_LOG

    # Generic CODEX_* sweep — covers CODEX_HOME, CODEX_SQLITE_HOME,
    # CODEX_API_KEY, CODEX_ACCESS_TOKEN, CODEX_CA_CERTIFICATE, and any
    # user-defined CODEX_* overrides in a single pass.
    forward_env_by_prefix CODEX_

    # --debug wrapper flag: force verbose logging regardless of host env.
    if [[ "${DEBUG_MODE}" -eq 1 ]]; then
        BWRAP_ARGS+=(--setenv RUST_LOG "debug")
    fi

    # GitHub CLI token passthrough (opt-in via --github-tokens).  In
    # --dry-run, print_dry_run redacts the values (the names match *TOKEN*).
    if [[ "${FORWARD_GH_TOKENS}" -eq 1 ]]; then
        forward_env_by_prefix GH_TOKEN_
    fi
}

# ── Complete Codex CLI package ──────────────────────────────────
# A packaged CLI needs codex-package.json and its sibling resource dirs to
# seed a managed app-server daemon.  The dynamic tool mount only sees the
# binary directory for a symlink such as /usr/bin/codex ->
# /opt/openai-codex/bin/codex.
# Mount the entire package when its metadata is present; npm installations
# are already covered by the dynamic npm-prefix mount.
build_codex_bin_mount() {
    local _real_bin _package_dir
    _real_bin="$(readlink -f -- "${_TOOL_BIN}")"
    _package_dir="$(dirname "$(dirname "${_real_bin}")")"
    if [[ -f "${_package_dir}/codex-package.json" ]]; then
        _mount_ro_dir_if_needed "${_package_dir}"
    fi
}

# ═══════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════

# ── Sandbox context ──────────────────────────────────────────────
# Mount the context file (see build_sandbox_context) and make Codex load it.
# -c developer_instructions=... is sent as a separate message and leaves
# AGENTS.md alone.  It is a single value, so it is not set when the user's
# config.toml (system, user or project) or command line already sets it: that
# would replace theirs.  The file is then only mounted.
build_codex_context() {
    # shellcheck disable=SC2034  # consumed by sourced bwrap_sandbox_lib.sh
    SANDBOX_CONTEXT_NOTES=()
    build_sandbox_context bwcodex
    [[ -n "${SANDBOX_CONTEXT_PATH}" && -z "${TEST_CMD}" ]] || return 0

    local _f _arg _toml
    for _f in "${SYSTEM_CODEX_CONFIG_FILE}" "${CODEX_CONFIG_FILE}" \
        "${_PWD}/.codex/config.toml" "${_GIT_ROOT:-${_PWD}}/.codex/config.toml"; do
        if [[ -r "${_f}" ]] && grep -qE '^[[:space:]]*developer_instructions[[:space:]]*=' "${_f}"; then
            echo "Warning: bwcodex: ${_f} sets developer_instructions, so Codex is not told to load ${SANDBOX_CONTEXT_PATH} (the file is still mounted)." >&2
            return 0
        fi
    done
    for _arg in ${TOOL_ARGS[@]+"${TOOL_ARGS[@]}"}; do
        [[ "${_arg}" == -- ]] && break
        if [[ "${_arg}" == *developer_instructions=* ]]; then
            echo "Warning: bwcodex: developer_instructions was given on the command line, so Codex is not told to load ${SANDBOX_CONTEXT_PATH} (the file is still mounted)." >&2
            return 0
        fi
    done
    if ! _toml="$(_bwrap_toml_string "${_SANDBOX_CONTEXT_TEXT}")"; then
        echo "Warning: bwcodex: cannot pass the sandbox context to Codex (unusual characters); the file is still mounted at ${SANDBOX_CONTEXT_PATH}." >&2
        return 0
    fi
    TOOL_ARGS=(-c "developer_instructions=${_toml}" ${TOOL_ARGS[@]+"${TOOL_ARGS[@]}"})
}

main() {
    bwrap_check_account
    parse_wrapper_args "$@"

    if [[ "${SHOW_HELP}" -eq 1 ]]; then
        show_help
        # show_help never returns
    fi

    bwrap_resolve_tool codex

    detect_bwrap_capabilities
    detect_kernel_capabilities
    resolve_common_paths
    resolve_codex_paths
    detect_shell
    # Skip host-state mutations on dry-run so --dry-run remains side-effect-free.
    if [[ "${DRY_RUN}" -eq 0 ]]; then
        ensure_host_dirs
    fi
    check_codex_config
    parse_all_git_includes
    init_sandbox_path

    # Build bwrap argument list
    build_base_sandbox
    build_proc_dev_tmp
    build_sys_mounts
    build_etc_mounts
    build_managed_skills
    build_home_tmpfs
    build_workdir_mount
    build_codex_home_mount
    build_codex_authoring_mounts
    build_git_mounts
    build_pixi_mounts
    build_ccache_mounts
    build_npm_mounts
    build_user_bin_mount
    build_nsls2_mount
    build_codex_bin_mount
    build_dynamic_tool_mounts
    build_n2c_token_mounts
    build_extra_path_mounts

    # Environment variables
    build_env_vars
    build_codex_env
    build_codex_context

    # Mask dangerous binaries as the very last step: a mask is hidden by any
    # later bind that covers it (e.g. --ro-path /usr or /usr/bin).
    build_binary_masks

    # Launch
    if [[ "${DRY_RUN}" -eq 1 ]]; then
        print_dry_run
    else
        launch_sandbox
    fi
}

main "$@"
