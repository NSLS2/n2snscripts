#!/usr/bin/env bash
# bwopencode2 — Launch OpenCode 2 (opencode2) inside a bubblewrap (bwrap) sandbox.
#
# Requires: bwrap >= 0.4.0 (RHEL 8)
#   Binary masking is verified on RHEL 8.10 (bubblewrap-0.4.0-3.el8_10) and EL9 (0.6.3).
#
# Requires the `opencode2` command (npm @opencode/cli), which the ansible base
# role installs.  OpenCode 2 is a separate product from
# OpenCode 1 (see bwopencode) and keeps its config, data and cache apart from
# it on the host.
#
# On the host the opencode2 convention separates the directories
# (~/.config|.local/share|.cache/opencode2/opencode); inside the sandbox
# everything is mounted at the standard locations (~/.config/opencode, ...), so
# no XDG_* override is set.  For the same reason the sandbox runs the OpenCode 2
# binary directly instead of the ansible /usr/local/bin/opencode2 wrapper, which
# exports XDG_*_HOME=~/.../opencode2 (see use_opencode2_binary).
#
# Requires at least a minimal OpenCode config: /etc/opencode/opencode.json{,c}
# or a user opencode.json, opencode.jsonc or config.json in
# ~/.config/opencode2/opencode.  Exits 2 if neither exists.
#
# The sandbox provides filesystem isolation:
#   - Current directory: read-write
#   - OpenCode 2 config (host ~/.config/opencode2/opencode, mounted at
#     ~/.config/opencode): read-only (symlinks resolved); service.json / service-*.json
#     (background-service settings) are not mounted
#   - Authoring directories ({skills,agents,commands} under the host config
#     directory, mounted under ~/.config/opencode): read-write, always created on the host, so
#     definitions authored in the sandbox persist; skills symlinked in from
#     elsewhere (e.g. a shared skills repository) work too
#   - Additional skills/agents/commands locations OpenCode reads
#     (~/.claude/{skills,agents,commands}, ~/.agents/{skills,agents}):
#     read-write, only if they already exist
#   - OpenCode 2 data (host ~/.local/share/opencode2/opencode, mounted at
#     ~/.local/share/opencode): read-write, the whole directory persists
#     (database incl. saved sign-in, logs, ...)
#   - OpenCode 2 cache (host ~/.cache/opencode2/opencode, mounted at
#     ~/.cache/opencode): read-write
#   - OpenCode 2 state (~/.local/state/opencode): ephemeral, except the TUI
#     plugin storage (host ~/.local/state/opencode2/opencode/latest/tui,
#     mounted at ~/.local/state/opencode/latest/tui): read-write, so
#     dismissed onboarding boxes and tab layout persist (locks and service
#     files, and last-used model and prompt history, are not remembered)
#   - Managed config: /etc/opencode/opencode.json{,c} and
#     /etc/opencode/{agents,commands,plugins,skills}, read-only
#   - Project .opencode/: persistent copy kept outside the repository
#   - OpenCode 1's config, database and other data are never mounted
#     (OpenCode 2 would migrate the database one way)
#   - Git config + includes: read-only (only the allowed_signers, config,
#     ignore and attributes files of git/ are mounted, never credentials)
#   - OPENCODE_* env vars: only an allowlist of harmless switches is passed
#     (see build_opencode2_env); OPENCODE_SERVER_PASSWORD etc. are dropped
#   - Pixi cache: read-write
#   - Pixi config: read-only
#   - ccache config: read-only
#   - ccache cache: read-write
#   - npm config: read-only
#   - npm cache: read-write
#   - System and user binaries: read-only
#   - SSH binaries: masked (ssh, scp, sftp, ssh-agent, etc.)
#   - Network tools: masked (telnet, nc/ncat, socat, rsync, rsh)
#   - Kerberos tools: masked (kinit, klist, kdestroy, kswitch)
#   - Privilege escalation: masked (sudo, su, pkexec)
#   - Namespace tools: masked (nsenter, unshare, chroot)
#   - Keyring tools: masked (keyctl)
#   - SSH/GPG agent env vars: stripped
#   - Zellij env vars (ZELLIJ, ZELLIJ_SESSION_NAME, ZELLIJ_PANE_ID): passed;
#     inside Zellij OPENTUI_FORCE_WCWIDTH=1 is also set so the TUI's column
#     counts match Zellij's (a user-set OPENTUI_FORCE_WCWIDTH wins)
#     and the TUI gets TERM=alacritty and COLORTERM=truecolor (when unset) so it
#     moves the cursor explicitly and a width mismatch cannot leave stale
#     regions (BWRAP_OPENTUI_TERM=<name> overrides the TERM, empty keeps it)
#   - ~/.bashrc and other shell rc files: not mounted
#
# Sandbox-escape guard: OpenCode 2 normally talks to a shared background
# service (fixed port 49374) that runs tools OUTSIDE any sandbox.  The wrapper
# therefore forces `--standalone` (a private in-process server) for the
# commands that accept it and refuses --server and the server-related
# commands (service, serve, api, pair, reload).  See --help.
#
# --serve is the one deliberate exception: it runs `opencode2 serve` INSIDE this
# sandbox (tools stay sandboxed) on a free port from a fixed range, protected by
# a password, and publishes that port (--publish) on this user's loopback
# address 127.H1.H2.S, so the OpenCode web UI can be opened from a browser (over
# an ssh -L tunnel).  The launcher builds those arguments itself; nothing from
# the command line reaches `serve`.  See docs/bw-wrappers.md.
#
# Usage:
#   bwopencode2 [bwopencode2-options] [opencode2 arguments...]
#   bwopencode2 --help
#
# Options:
#   --help, -h      Show this help (wrapper options + opencode2's own help).
#   --dry-run       Print the bwrap command that would be executed without running it.
#   --exec CMD      Run CMD inside the sandbox instead of opencode2.
#                   Useful for running one-off commands, scripts, or diagnostic tools
#                   inside the fully-configured sandbox environment.  The command is
#                   NOT subject to the --standalone argument guard (it is arbitrary).
#   --new-session   Force bwrap --new-session even on kernels with the TIOCSTI cap
#                   guard.  Detaches the controlling tty for stricter isolation at the
#                   cost of SIGWINCH (terminal resize) propagation.
#   --serve         Run the OpenCode web UI server inside the sandbox instead of the
#                   TUI and publish its port (see above).  One server per invocation.
#   --serve-port N  With --serve: use port N (must be in the range) instead of the
#                   first free one.
#   --serve-ssh-config
#                   Print the ssh_config block that forwards the whole port range, then
#                   exit.
#   --n2c-token NAME  Mount the N2C access token NAME read-only (for NSLS-II API
#                   skills).  May be repeated; `all` mounts every token present.
#                   Off by default.  The refresh token is never mounted.
#   --ro-path PATH  Mount PATH read-only into the sandbox.  May be repeated to
#                   accumulate multiple paths.  Dangerous paths are blocked:
#                   $HOME and ancestors, ~/.ssh, ~/.gnupg, ~/.aws, ~/.kube,
#                   ~/.docker, ~/.netrc, ~/.pypirc, ~/.rattler, ~/.yarnrc,
#                   ~/.yarnrc.yml, ~/.yarn, ~/.config/gh,
#                   $XDG_DATA_HOME/uv/credentials, /root, /etc/shadow,
#                   /etc/sudoers{,.d}.
#   --rw-path PATH  Mount PATH read-write into the sandbox.  May be repeated to
#                   accumulate multiple paths.  Same blocked-path rules as --ro-path.
#                   A nested --ro-path/--rw-path overrides the one it sits under,
#                   so `--rw-path DIR --ro-path DIR/sub` protects DIR/sub.
#   --github-tokens Forward any GH_TOKEN_* environment variables into the sandbox.
#   --no-sandbox-context
#                   Do not generate the sandbox context file (see below).
#   --publish PORT[:SANDBOXPORT]
#                   Make a server in the sandbox reachable on the host at a
#                   per-user, per-session loopback address (127.H1.H2.S:PORT).
#                   May be repeated.
#   --publish-addr ADDR
#                   Use ADDR (in 127.0.0.0/8) for --publish instead.
#   --host-port PORT[:SANDBOXPORT]
#                   Make the host's 127.0.0.1:PORT reachable in the sandbox at
#                   host.internal:SANDBOXPORT.  May be repeated.
#   --share-net     Share the host network instead (the behaviour before
#                   private namespaces); not with the options above.
#   --net-backend pasta|slirp4netns
#                   Use only this backend for the private namespace.
#
# Network: the sandbox has its own network namespace from pasta (package
# passt), or else slirp4netns (--host-port needs pasta).
# Outbound connections work; services on the host's loopback are unreachable
# and the sandbox's listeners are invisible to the host, except for the ports
# opened with --publish and --host-port.  Without a usable private namespace
# the launch stops (exit 3) unless --share-net is given.  Every session (with
# pasta every connection too) is recorded in the host's system log, tag
# bwrap-net; there is no option to turn this off.
#
# Sandbox context: a short markdown file describing this sandbox (what is
# mounted read-only or read-write, what is lost at exit, which tools are
# disabled) is built from the final mounts and mounted read-only at
# ~/.sandbox/AGENTS.md, and BWRAP_SANDBOX / BWRAP_SANDBOX_CONTEXT are set.
# OpenCode 2 loads it through OPENCODE_CONFIG_CONTENT, whose "instructions"
# list is added to the user's own instructions (verified with 2.1.4); no user
# file is overwritten.  Not added to a --exec command.
#
# There is no --init-auth: OpenCode 2 stores credentials in its database
# (the `credential` table in opencode.db), which lives in the persistent
# data directory, so sign-in (`opencode2 auth login`) persists on its own.
#
# Database guard: opencode.db is on NFS and OpenCode 2 runs it in WAL mode,
# which SQLite does not support across hosts; two builds sharing it damaged
# it.  Before the sandbox starts, lib/opencode2-db-lock.sh refuses to start
# when another host, or another OpenCode 2 build on this host, uses the same
# data directory, holds a lock for the life of the sandbox, and starts a daily
# background backup (bin/opencode2-db).  OPENCODE2_DB_GUARD=off skips it.
# See docs/bw-wrappers.md (Database guard).

set -euo pipefail

# Source the shared sandbox library.
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../lib/bwrap_sandbox_lib.sh
source "${SCRIPT_DIR}/../lib/bwrap_sandbox_lib.sh"

# ═══════════════════════════════════════════════════════════════════
# Tool-specific state
# ═══════════════════════════════════════════════════════════════════

FORWARD_GH_TOKENS=0
OC2_CONFIG_BINDS=()

# --serve state.  The password is passed to the server only as OPENCODE_PASSWORD
# (see build_opencode2_env) and is never written to a file.
SERVE=0
SERVE_SSH_CONFIG=0
SERVE_PORT_REQUEST=""
SERVE_PORT=""
SERVE_PASSWORD=""
SERVE_PASSWORD_RANDOM=0
SERVE_PORT_LO=""
SERVE_PORT_HI=""
SERVE_STATE_DIR=""
# Address the server is reached at on the host: this user's publish address
# (127.H1.H2.S, see net_publish_prefix) or --publish-addr.  With a private
# network the port is published there and the server binds 0.0.0.0 inside the
# sandbox; with --share-net the server binds this address itself.
SERVE_ADDR=""
SERVE_BIND=""
# Default range: below the kernel's ephemeral range (32768-60999 on Linux, so no
# outgoing connection takes a server port), clear of the shared OpenCode service
# (49374) and of the ports in use on the workstations.  Keep ssh_config in step
# with it: --serve-ssh-config prints the matching block.
SERVE_DEFAULT_PORTS="24700-24709"
SERVE_SHARED_SERVICE_PORT=49374

# ═══════════════════════════════════════════════════════════════════
# Tool-specific functions
# ═══════════════════════════════════════════════════════════════════

parse_wrapper_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help | -h)
                SHOW_HELP=1
                shift
                ;;
            --dry-run)
                DRY_RUN=1
                shift
                ;;
            --exec)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --exec requires a command argument." >&2
                    exit 1
                fi
                TEST_CMD="$2"
                shift 2
                ;;
            --github-tokens)
                FORWARD_GH_TOKENS=1
                shift
                ;;
            --new-session)
                # shellcheck disable=SC2034  # consumed by sourced bwrap_sandbox_lib.sh (sandboxed_exec)
                FORCE_NEW_SESSION=1
                shift
                ;;
            --n2c-token)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --n2c-token requires a token name or 'all'." >&2
                    exit 1
                fi
                add_n2c_token "$2"
                shift 2
                ;;
            --no-sandbox-context)
                # shellcheck disable=SC2034  # consumed by sourced bwrap_sandbox_lib.sh
                SANDBOX_CONTEXT_ENABLED=0
                shift
                ;;
            --serve)
                SERVE=1
                shift
                ;;
            --serve-port)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --serve-port requires a port number." >&2
                    exit 1
                fi
                SERVE_PORT_REQUEST="$2"
                shift 2
                ;;
            --serve-ssh-config)
                SERVE_SSH_CONFIG=1
                shift
                ;;
            --publish)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --publish requires PORT[:SANDBOXPORT]." >&2
                    exit 1
                fi
                net_add_publish "$2"
                shift 2
                ;;
            --publish-addr)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --publish-addr requires an address in 127.0.0.0/8." >&2
                    exit 1
                fi
                net_set_publish_addr "$2"
                shift 2
                ;;
            --host-port)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --host-port requires PORT[:SANDBOXPORT]." >&2
                    exit 1
                fi
                net_add_host_port "$2"
                shift 2
                ;;
            --share-net)
                net_set_share
                shift
                ;;
            --net-backend)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --net-backend requires pasta or slirp4netns." >&2
                    exit 1
                fi
                net_set_backend "$2"
                shift 2
                ;;
            --ro-path)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --ro-path requires a path argument." >&2
                    exit 1
                fi
                EXTRA_RO_PATHS+=("$2")
                shift 2
                ;;
            --rw-path)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --rw-path requires a path argument." >&2
                    exit 1
                fi
                EXTRA_RW_PATHS+=("$2")
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done
    # shellcheck disable=SC2034  # consumed by library's print_dry_run/launch_sandbox
    TOOL_ARGS=("$@")
}

# Find the absolute path to the opencode2 binary on the host so we do
# not depend on PATH lookup inside the sandbox.
# Sets globals: _TOOL_BIN, _TOOL_CMD
show_help() {
    cat << 'HELP_EOF'
bwopencode2 — OpenCode 2 (opencode2) inside a bubblewrap sandbox

Wrapper options (consumed before opencode2 sees the command line):
  -h, --help      Show this message followed by opencode2's own help.
  --dry-run       Print the bwrap command that would be run, then exit.
  --exec CMD      Run CMD inside the fully-configured sandbox instead of opencode2.
                  Use this to run scripts, diagnostic tools, or any command with
                  the same filesystem isolation and environment as opencode2 itself.
                  Example: bwopencode2 --exec bash
                           bwopencode2 --exec bash -c 'env | sort'
                  CMD itself is split on whitespace; pass arguments that need
                  quoting as separate words after it, as above.
  --new-session   Force bwrap to call setsid(2), detaching the sandbox from the
                  controlling terminal.  This is the default on older kernels
                  (< 5.14); on newer kernels we omit it so that SIGWINCH (terminal
                  resize) propagates from tmux/screen.  Use this flag to opt back
                  into stricter terminal isolation when SIGWINCH is not important.
  --serve         Run the OpenCode web UI server inside the sandbox instead of the
                  TUI, tools still sandboxed: `opencode2 serve` on the first free
                  port of the range 24700-24709 (override the range with
                  BWOPENCODE2_SERVE_PORTS=LO-HI), published like --publish on your
                  loopback address 127.H1.H2.S (printed; with --share-net the
                  server binds that address itself, never 0.0.0.0).  Open it
                  from a browser through an ssh tunnel; the command, a one-time
                  pairing link (valid 5 minutes) and the password are printed at
                  start; the web UI's "Use password" button also works.  The
                  password is random for each
                  session unless BWOPENCODE2_SERVE_PASSWORD is set (at least 12
                  characters; a fixed password is shared by every session that
                  uses it).  Takes no opencode2 arguments and cannot be combined
                  with --exec.  One server per invocation.
  --serve-port N  With --serve, use port N (inside the range) instead of the first
                  free one; fails if it is taken.
  --serve-ssh-config
                  Print the ssh_config block (one alias, one LocalForward per port
                  of the range, to your address 127.H1.H2.1) for the machine your
                  browser runs on, then exit.
  --n2c-token NAME
                  Mount the N2C access token NAME (read-only) so skills inside
                  the sandbox can call NSLS-II APIs, for example observability,
                  docs or epics.  May be repeated; `--n2c-token all` mounts every
                  token present.  Off by default: no token is mounted unless
                  asked for.  Tokens are written on the host by `n2c-token`
                  (run `n2c-token login` first); the refresh token is never
                  mounted.  A missing token only warns.
  --ro-path PATH  Mount PATH (file or directory) read-only into the sandbox.
                  May be repeated to accumulate multiple extra paths.
                  Blocked: $HOME and ancestors, ~/.ssh, ~/.gnupg, ~/.aws,
                  ~/.kube, ~/.docker, ~/.netrc, ~/.pypirc, ~/.rattler,
                  ~/.yarnrc, ~/.yarnrc.yml, ~/.yarn, ~/.config/gh,
                  $XDG_DATA_HOME/uv/credentials, /root, /etc/shadow,
                  /etc/sudoers{,.d}.
                  Symlinks are resolved before the safety check is applied.
  --rw-path PATH  Mount PATH (file or directory) read-write into the sandbox.
                  Same blocked-path rules as --ro-path.  May be repeated.
                  --ro-path/--rw-path may nest: a nested path overrides the one
                  it sits under, so `--rw-path DIR --ro-path DIR/sub` keeps DIR
                  writable but DIR/sub read-only.
  --github-tokens Forward any GH_TOKEN_* environment variables into the
                  sandbox so the agent can authenticate the gh(1) CLI.
                  Off by default.  When set, use per-command token selection:
                    GH_TOKEN="$GH_TOKEN_NSLS2" gh pr list -R NSLS2/repo
                    GH_TOKEN="$GH_TOKEN_PERSONAL" gh issue list -R user/repo

On the host OpenCode 2 data lives under ~/.local/share|.cache/opencode2/opencode
(never the OpenCode 1 directories); inside the sandbox it is mounted at the
standard locations (~/.local/share/opencode, ...), and the config is
~/.config/opencode2/opencode mounted at ~/.config/opencode.  Sign-in is stored in the database in the
persistent data directory, so there is no --init-auth.

Inside the sandbox the OpenCode 2 binary is run directly, not through the
/usr/local/bin/opencode2 wrapper: the wrapper's XDG_* exports would point
OpenCode 2 (and every tool it runs) away from the standard locations.  Use
the binary with --exec as well, not `opencode2`.

Sandbox-escape guard: OpenCode 2 normally connects to a shared background
service that runs tools OUTSIDE the sandbox.  To keep tools sandboxed:
  - `--standalone` (a private in-process server) is added automatically when
    you run opencode2 with no subcommand or with run, mini, models or stats.
  - `--server`, `--standalone=...` and `--no-standalone` are refused, as are
    the service, serve, api, pair and reload subcommands.
  - All other subcommands (auth, debug, mcp, plugin, session, upgrade, ...)
    are passed through unchanged.
Limitation: the first non-option argument is taken as the subcommand; options
that take a value are only recognised for --session/-s, --prompt, --log-level
and --completions.  Arguments after `--` are never inspected.

--exec runs an arbitrary command and therefore bypasses this argument guard.
--serve is the one way to run `serve`: the wrapper builds its arguments itself.

Database guard: the OpenCode 2 database is on NFS, where SQLite's WAL mode is
only safe from one host.  bwopencode2 refuses to start while another host, or
another OpenCode 2 build on this host, is using the same data directory, and
makes a daily compressed backup (opencode2-db status shows them; opencode2-db
restore and rebuild recover).  Set OPENCODE2_DB_GUARD=off to skip the checks
once.  Not applied to --exec, --dry-run or --help.

Also kept out of the sandbox: service.json (service settings), all OPENCODE_*
environment variables except a short allowlist of harmless switches (see
docs/bw-wrappers.md; OPENCODE_SERVER_PASSWORD etc. are dropped), and the
git credentials file (only a few files of the XDG git directory are mounted).

All other arguments are passed through to opencode2 unchanged.

HELP_EOF
    net_print_help
    # Delegate to opencode2 --help inside the sandbox so the user sees the full
    # opencode2 option set in the same invocation.  We re-exec this script with
    # --exec so the sandbox is fully constructed; opencode2 --help is passed
    # as the sandbox command.
    bwrap_show_tool_help opencode2
}

# ── --serve: OpenCode web UI server inside the sandbox ───────────
# `opencode2 serve` is refused as a command-line argument (see the guard below)
# because the shared service it could reach runs tools outside any sandbox.
# --serve runs the server inside THIS sandbox instead, so tools stay sandboxed:
#   - reached on the host at this user's publish address 127.H1.H2.S (normally
#     .1; see net_publish_prefix): with a private network the port is added to
#     --publish and the server binds 0.0.0.0 inside the namespace (forwarded
#     connections arrive at its interface); with --share-net the server binds
#     the address itself.  From a browser elsewhere, use an ssh -L tunnel;
#   - one server per invocation, on the first free port of a fixed range, so one
#     ssh_config block covers every session (--serve-ssh-config);
#   - protected by a password that reaches the server only as OPENCODE_PASSWORD.
#     It is random for each session unless BWOPENCODE2_SERVE_PASSWORD is set.
#     A fixed password is shared by all sessions that use it: any process that
#     holds it (including a sandboxed agent that can read its own environment)
#     can drive every one of them.
# The launcher execs bwrap, so it cannot clean up or retry after the server
# starts.  A port is claimed with a file in the host-side state directory (not
# mounted in the sandbox), which stops two launchers picking one port, and it
# must be free on the address checked (127.H1.H2.1 or --publish-addr); a claim
# whose process is gone is stale and is removed.  The remaining race is another
# program taking the port in the moment before the server binds it.

serve_host_name() {
    hostname -f 2> /dev/null || hostname
}

serve_ssh_alias() {
    local _h
    _h="$(hostname -s 2> /dev/null || hostname)"
    printf '%s-oc' "${_h%%.*}"
}

# Validate BWOPENCODE2_SERVE_PORTS (LO-HI) into SERVE_PORT_LO / SERVE_PORT_HI.
serve_parse_range() {
    local _spec="${BWOPENCODE2_SERVE_PORTS:-${SERVE_DEFAULT_PORTS}}"
    if [[ ! "${_spec}" =~ ^([0-9]+)-([0-9]+)$ ]]; then
        echo "Error: BWOPENCODE2_SERVE_PORTS must look like 24700-24709 (got '${_spec}')." >&2
        exit 1
    fi
    SERVE_PORT_LO=$((10#${BASH_REMATCH[1]}))
    SERVE_PORT_HI=$((10#${BASH_REMATCH[2]}))
    if ((SERVE_PORT_LO < 1024 || SERVE_PORT_HI > 65535 || SERVE_PORT_LO > SERVE_PORT_HI)); then
        echo "Error: BWOPENCODE2_SERVE_PORTS must be an ascending range within 1024-65535 (got '${_spec}')." >&2
        exit 1
    fi
    if ((SERVE_PORT_HI - SERVE_PORT_LO > 99)); then
        echo "Error: BWOPENCODE2_SERVE_PORTS may hold at most 100 ports (got '${_spec}')." >&2
        exit 1
    fi
    if ((SERVE_SHARED_SERVICE_PORT >= SERVE_PORT_LO && SERVE_SHARED_SERVICE_PORT <= SERVE_PORT_HI)); then
        echo "Error: BWOPENCODE2_SERVE_PORTS must not include ${SERVE_SHARED_SERVICE_PORT}, the port of the shared OpenCode service." >&2
        exit 1
    fi
    local _eph_lo _eph_hi
    if read -r _eph_lo _eph_hi < /proc/sys/net/ipv4/ip_local_port_range 2> /dev/null &&
        [[ "${_eph_lo}" =~ ^[0-9]+$ && "${_eph_hi}" =~ ^[0-9]+$ ]] &&
        ((SERVE_PORT_HI >= _eph_lo && SERVE_PORT_LO <= _eph_hi)); then
        printf 'bwopencode2: warning: ports %s-%s overlap the kernel ephemeral range %s-%s; an outgoing connection can take a server port.\n' \
            "${SERVE_PORT_LO}" "${SERVE_PORT_HI}" "${_eph_lo}" "${_eph_hi}" >&2
    fi
}

# Print the ssh_config block for the port range (--serve-ssh-config).
serve_print_ssh_config() {
    local _p _addr
    _addr="$(net_publish_prefix).1"
    printf '# Add to ~/.ssh/config on the machine your browser runs on, then: ssh %s\n' "$(serve_ssh_alias)"
    printf '# One forward per port of the bwopencode2 --serve range %s-%s, to %s, your\n' "${SERVE_PORT_LO}" "${SERVE_PORT_HI}" "${_addr}"
    printf '# own publish address on %s (it depends on your uid: run this as the user who\n' "$(serve_host_name)"
    printf '# runs the sessions).  A port with no session behind it just refuses\n'
    printf '# connections.  Add User / ProxyJump as needed.\n'
    printf 'Host %s\n' "$(serve_ssh_alias)"
    printf '    HostName %s\n' "$(serve_host_name)"
    printf '    ExitOnForwardFailure no\n'
    for ((_p = SERVE_PORT_LO; _p <= SERVE_PORT_HI; _p++)); do
        printf '    LocalForward %s %s:%s\n' "${_p}" "${_addr}" "${_p}"
    done
}
# Refuse combinations that make no sense; validate --serve-port.
serve_check_args() {
    if [[ "${SERVE}" -eq 0 ]]; then
        if [[ -n "${SERVE_PORT_REQUEST}" ]]; then
            echo "Error: --serve-port needs --serve." >&2
            exit 1
        fi
        return 0
    fi
    if [[ -n "${TEST_CMD}" ]]; then
        echo "Error: --serve cannot be combined with --exec." >&2
        exit 1
    fi
    if [[ ${#TOOL_ARGS[@]} -gt 0 ]]; then
        echo "Error: --serve takes no opencode2 arguments (got '${TOOL_ARGS[*]}')." >&2
        exit 1
    fi
    if [[ -n "${SERVE_PORT_REQUEST}" ]]; then
        if [[ ! "${SERVE_PORT_REQUEST}" =~ ^[0-9]+$ ]] ||
            ((10#${SERVE_PORT_REQUEST} < SERVE_PORT_LO || 10#${SERVE_PORT_REQUEST} > SERVE_PORT_HI)); then
            echo "Error: --serve-port must be a port in ${SERVE_PORT_LO}-${SERVE_PORT_HI} (the ssh_config range), got '${SERVE_PORT_REQUEST}'." >&2
            exit 1
        fi
        SERVE_PORT_REQUEST=$((10#${SERVE_PORT_REQUEST}))
    fi
}

# True when nothing listens on ADDR:PORT (the bind succeeds, as the server's or
# the network backend's would; SO_REUSEADDR as a server sets it, so a lingering
# TIME_WAIT does not count).
serve_port_is_free() {
    local _addr="$1" _port="$2"
    if command -v python3 > /dev/null 2>&1; then
        python3 -c '
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind((sys.argv[1], int(sys.argv[2])))
' "${_addr}" "${_port}" 2> /dev/null
    else
        # No python3: a successful connection means something listens.
        if (exec 3<> "/dev/tcp/${_addr}/${_port}") 2> /dev/null; then
            return 1
        fi
    fi
}

# True when claim file F belongs to a launcher that is still running.  A file
# without a pid is being written by another launcher: live unless it is old.
serve_claim_is_live() {
    local _f="$1" _pid _mtime _now
    [[ -e "${_f}" ]] || return 1
    _pid="$(sed -n 's/^pid=//p' "${_f}" 2> /dev/null | head -n 1)"
    if [[ "${_pid}" =~ ^[0-9]+$ ]]; then
        # The start time guards against a reused pid (see bwrap_proc_is).
        bwrap_proc_is "${_pid}" "$(sed -n 's/^start=//p' "${_f}" 2> /dev/null | head -n 1)"
        return
    fi
    _mtime="$(stat -c %Y "${_f}" 2> /dev/null || echo 0)"
    _now="$(date +%s)"
    ((_now - _mtime < 10))
}

# Claim PORT atomically.  The file holds no secret: the pid is this launcher's,
# which stays the pid of the bwrap process because the launch ends in exec.
serve_claim_port() {
    local _port="$1" _f="${SERVE_STATE_DIR}/$1.session"
    if serve_claim_is_live "${_f}"; then
        return 1
    fi
    rm -f "${_f}"
    (set -o noclobber && : > "${_f}") 2> /dev/null || return 1
    {
        printf 'pid=%s\n' "$$"
        printf 'start=%s\n' "$(bwrap_proc_start_time "$$")"
        printf 'port=%s\n' "${_port}"
        printf 'host=%s\n' "$(serve_host_name)"
        printf 'dir=%s\n' "${_PWD}"
        printf 'started=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "${_f}"
}

# Pick the port (the requested one, or the first free one of the range).  On
# --dry-run nothing is claimed and no directory is created.
serve_choose_port() {
    local _p _f
    SERVE_STATE_DIR="${_HOME}/.local/state/bwopencode2/serve"
    local -a _candidates=()
    if [[ -n "${SERVE_PORT_REQUEST}" ]]; then
        _candidates=("${SERVE_PORT_REQUEST}")
    else
        for ((_p = SERVE_PORT_LO; _p <= SERVE_PORT_HI; _p++)); do
            _candidates+=("${_p}")
        done
    fi

    if [[ "${DRY_RUN}" -eq 0 ]]; then
        mkdir -p "${SERVE_STATE_DIR}"
        chmod 700 "${SERVE_STATE_DIR}"
        for _f in "${SERVE_STATE_DIR}"/*.session; do
            [[ -e "${_f}" ]] || continue
            serve_claim_is_live "${_f}" || rm -f "${_f}"
        done
    fi

    for _p in "${_candidates[@]}"; do
        _f="${SERVE_STATE_DIR}/${_p}.session"
        if [[ "${DRY_RUN}" -eq 1 ]]; then
            serve_claim_is_live "${_f}" && continue
            serve_port_is_free "${SERVE_ADDR}" "${_p}" || continue
        else
            serve_claim_port "${_p}" || continue
            if ! serve_port_is_free "${SERVE_ADDR}" "${_p}"; then
                rm -f "${_f}"
                continue
            fi
        fi
        SERVE_PORT="${_p}"
        return 0
    done

    if [[ -n "${SERVE_PORT_REQUEST}" ]]; then
        echo "Error: port ${SERVE_PORT_REQUEST} is in use on ${SERVE_ADDR}." >&2
    else
        echo "Error: no free port in ${SERVE_PORT_LO}-${SERVE_PORT_HI}; stop a session or see ${SERVE_STATE_DIR}/." >&2
    fi
    exit 1
}

# Set SERVE_PASSWORD: BWOPENCODE2_SERVE_PASSWORD, else a random one.
serve_make_password() {
    if [[ -n "${BWOPENCODE2_SERVE_PASSWORD:-}" ]]; then
        if ((${#BWOPENCODE2_SERVE_PASSWORD} < 12)); then
            echo "Error: BWOPENCODE2_SERVE_PASSWORD must have at least 12 characters." >&2
            exit 1
        fi
        SERVE_PASSWORD="${BWOPENCODE2_SERVE_PASSWORD}"
        SERVE_PASSWORD_RANDOM=0
        return 0
    fi
    if command -v openssl > /dev/null 2>&1; then
        SERVE_PASSWORD="$(openssl rand -hex 16)"
    else
        SERVE_PASSWORD="$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    fi
    if [[ ${#SERVE_PASSWORD} -lt 32 ]]; then
        echo "Error: could not generate a random password." >&2
        exit 1
    fi
    SERVE_PASSWORD_RANDOM=1
}

# The command run INSIDE the sandbox for --serve: start the server, then print a
# one-time pairing link so the browser can sign in without typing the password
# (the web UI's "Use password" button still works).  It runs as
# `bash -c SERVE_WRAPPER bwopencode2-serve BINARY PORT BIND`.  OPENCODE_PASSWORD is in
# its environment.  The password reaches curl on stdin (-K -), never on a command
# line: a process in the sandbox is visible to `ps` on the host.  printf is a
# builtin, so it does not show either.  Needs only bash and curl.
read -r -d '' SERVE_WRAPPER << 'SERVE_WRAPPER_EOF' || true
set -u
bin=$1 port=$2 bind=$3
# The server's own address for the requests below, and the host-side address
# for the printed link (the publish address, or the bound one with --share-net).
local_addr=$bind
[[ $bind != 0.0.0.0 ]] || local_addr=127.0.0.1
base="http://${local_addr}:${port}"
host_addr=${BWRAP_NET_PUBLISH_ADDR:-$bind}

"$bin" serve --hostname "$bind" --port "$port" &
srv=$!
trap 'kill "$srv" 2>/dev/null' INT TERM HUP

# Wait up to about 30 s for the server to answer; without credentials /api/info
# gives 401, which is enough to know it is listening.
ready=0
for _ in $(seq 60); do
    kill -0 "$srv" 2> /dev/null || break
    code=$(curl -s -o /dev/null -w '%{http_code}' "${base}/api/info") || code=000
    if [[ $code == 401 || $code == 200 ]]; then
        ready=1
        break
    fi
    sleep 0.5
done

{
    if [[ $ready -eq 1 ]]; then
        resp=$(printf 'user = "opencode:%s"\n' "$OPENCODE_PASSWORD" |
            curl -s -K - -X POST "${base}/api/pair") || resp=""
        if [[ $resp =~ \"code\":\"([A-Za-z0-9_-]+)\" ]]; then
            printf '\nbwopencode2: pairing link (works once, expires in 5 minutes):\n'
            printf '  through the ssh tunnel:  http://127.0.0.1:%s/auth/connect/%s\n' "$port" "${BASH_REMATCH[1]}"
            printf '  on this host:            http://%s:%s/auth/connect/%s\n' "$host_addr" "$port" "${BASH_REMATCH[1]}"
            printf '  After it expires, click "Use password" in the web UI instead.\n\n'
        else
            printf 'bwopencode2: could not get a pairing link; click "Use password" in the web UI.\n'
        fi
    else
        printf 'bwopencode2: the server did not start listening on %s.\n' "$bind:$port"
    fi
} >&2

wait "$srv"
SERVE_WRAPPER_EOF

# Choose port and password, and give the sandbox its command.
serve_prepare() {
    if [[ "${NET_SHARE}" -eq 1 ]]; then
        SERVE_ADDR="$(net_publish_prefix).1"
    else
        SERVE_ADDR="${NET_PUBLISH_ADDR:-$(net_publish_prefix).1}"
    fi
    serve_choose_port
    serve_make_password
    if [[ "${NET_SHARE}" -eq 1 ]]; then
        SERVE_BIND="${SERVE_ADDR}"
    else
        # Forwarded connections arrive at the namespace's interface, not its
        # loopback, so the server binds every address of the private
        # namespace; only the published port reaches it.
        SERVE_BIND="0.0.0.0"
        net_add_publish "${SERVE_PORT}"
    fi
    _TOOL_CMD=(/usr/bin/bash -c "${SERVE_WRAPPER}" bwopencode2-serve "${_TOOL_BIN}" "${SERVE_PORT}" "${SERVE_BIND}")
    TOOL_ARGS=()
}
# Tell the user how to reach the server (stderr, before the exec).
serve_print_info() {
    local _p="${SERVE_PORT}" _host _alias _addr="${SERVE_ADDR}"
    [[ "${NET_SHARE}" -eq 1 ]] || _addr="${_NET_PUBLISH_ADDR_EFFECTIVE}"
    _host="$(serve_host_name)"
    _alias="$(serve_ssh_alias)"
    {
        printf '\nbwopencode2: sandboxed OpenCode 2 web UI on %s:%s (this host only)\n' "${_addr}" "${_p}"
        printf '  1. On the machine with your browser, forward the port:\n'
        printf '       ssh -L %s:%s:%s %s\n' "${_p}" "${_addr}" "${_p}" "${_host}"
        if [[ "${_addr}" == "$(net_publish_prefix).1" ]]; then
            printf '     or use the ssh_config alias (bwopencode2 --serve-ssh-config):  ssh %s\n' "${_alias}"
        else
            printf '     (the ssh_config alias from --serve-ssh-config forwards to %s.1, so it does\n' "$(net_publish_prefix)"
            printf '     not reach this session: use the command above)\n'
        fi
        printf '     then open http://127.0.0.1:%s/ there.  On this host itself, open http://%s:%s/.\n' "${_p}" "${_addr}" "${_p}"
        printf '  2. Open the pairing link printed below once the server is up (it works once and\n'
        printf '     expires in 5 minutes), or open the page above, click "Use password"\n'
        printf '     and enter the server password.\n'
        if [[ "${DRY_RUN}" -eq 1 ]]; then
            printf '     Password: (not shown on --dry-run)\n'
        elif [[ "${SERVE_PASSWORD_RANDOM}" -eq 1 ]]; then
            printf '     Password (new for this session): %s\n' "${SERVE_PASSWORD}"
        else
            printf '     Password: the value of BWOPENCODE2_SERVE_PASSWORD (shared by every session that uses it)\n'
        fi
        printf '  Keep the same port number at both ends of the tunnel: the browser cookie is named by it.\n\n'
    } >&2
}
# ── Sandbox-escape guard (arguments) ─────────────────────────────
# The OpenCode 2 background service listens on a fixed, shared port and runs
# tools outside any sandbox.  A CLI started without --standalone would
# delegate tool execution to it.  The sandbox's private network namespace
# already keeps the host's loopback (and so the service) out of reach, and
# --host-port refuses the port; this guard is kept as a second line of
# defence, and so that the CLI does not hang looking for the service.
#
# guard_tool_args scans TOOL_ARGS and either refuses the invocation or
# injects --standalone:
#   - refuse: --server[=...], --standalone=..., --no-standalone anywhere before
#     a bare `--`; subcommands service, serve, api, pair, reload.
#   - inject --standalone: no subcommand (or a directory argument), run, mini,
#     models, stats (the commands whose `--help` lists the flag).
#   - the known subcommands auth, debug, mcp, plugin, session, upgrade/update,
#     uninstall, acp do not accept --standalone and are passed through.
#
# Known limitations: the subcommand is the first non-option argument; only the
# root flags --session/-s, --prompt, --log-level and --completions are known to
# consume the next argument.  Combined short flags are not split.  A bare `--`
# ends option scanning, so a prompt after `--` can never trigger a refusal.
guard_tool_args() {
    local _n=${#TOOL_ARGS[@]} _i _arg _sub="" _sub_idx=-1 _has_standalone=0 _inject_front=0

    # Pass 1: options that would bypass the private server (all positions).
    for ((_i = 0; _i < _n; _i++)); do
        _arg="${TOOL_ARGS[_i]}"
        case "${_arg}" in
            --)
                break
                ;;
            --server | --server=*)
                echo "Error: bwopencode2 refuses '--server': it would connect to a server" >&2
                echo "       that runs tools outside the sandbox." >&2
                exit 1
                ;;
            --standalone=* | --no-standalone)
                echo "Error: bwopencode2 refuses '${_arg}': the sandbox requires --standalone." >&2
                exit 1
                ;;
            --standalone)
                _has_standalone=1
                ;;
        esac
    done

    # Pass 2: find the subcommand (first non-option argument).
    _i=0
    while ((_i < _n)); do
        _arg="${TOOL_ARGS[_i]}"
        case "${_arg}" in
            --)
                break
                ;;
            --session | -s | --prompt | --log-level | --completions)
                _i=$((_i + 2))
                ;;
            -*)
                _i=$((_i + 1))
                ;;
            *)
                _sub="${_arg}"
                _sub_idx=${_i}
                break
                ;;
        esac
    done

    case "${_sub}" in
        service | serve | api | pair | reload)
            echo "Error: bwopencode2 refuses '${_sub}': it starts or talks to a server that" >&2
            echo "       runs outside the sandbox." >&2
            exit 1
            ;;
        "")
            # No subcommand: interactive TUI.
            _inject_front=1
            ;;
        run | mini | models | stats)
            if [[ "${_has_standalone}" -eq 0 ]]; then
                # Insert right after the subcommand word.
                local -a _new_args=()
                for ((_i = 0; _i < _n; _i++)); do
                    _new_args+=("${TOOL_ARGS[_i]}")
                    if [[ "${_i}" -eq "${_sub_idx}" ]]; then
                        _new_args+=(--standalone)
                    fi
                done
                TOOL_ARGS=("${_new_args[@]}")
            fi
            ;;
        auth | debug | mcp | plugin | session | upgrade | update | uninstall | acp)
            : # known subcommands without --standalone: unchanged
            ;;
        *)
            # Not a known subcommand: the TUI's positional directory argument
            # (e.g. `opencode2 ~/proj`), which also needs --standalone.
            _inject_front=1
            ;;
    esac

    if [[ "${_inject_front}" -eq 1 && "${_has_standalone}" -eq 0 ]]; then
        TOOL_ARGS=(--standalone ${TOOL_ARGS[@]+"${TOOL_ARGS[@]}"})
    fi
}

# ── Run the OpenCode 2 binary, not the ansible wrapper ───────────
# /usr/local/bin/opencode2 (ansible) exports
# XDG_{CONFIG,DATA,STATE,CACHE}_HOME=~/.{config,local/share,local/state,cache}/opencode2
# to keep OpenCode 2 apart from OpenCode 1 on the host.  Inside the sandbox
# only the OpenCode 2 directories are mounted, at the standard locations, so
# those exports would point OpenCode 2 at empty directories (no config,
# plugins or database) and leak into every tool it runs (git, pixi and ccache
# would miss their config).  The wrapper's other job, --standalone, is done
# by guard_tool_args.  Falls back to the wrapper when the binary is not at the
# ansible install path.  --exec commands are left alone.
# Sets globals: _TOOL_BIN, _TOOL_CMD
OC2_INSTALL_BIN="/opt/nsls2/opencode2/node_modules/@opencode/cli/bin/opencode.exe"
use_opencode2_binary() {
    [[ -z "${TEST_CMD}" ]] || return 0
    [[ -x "${OC2_INSTALL_BIN}" ]] || return 0
    _TOOL_BIN="${OC2_INSTALL_BIN}"
    _TOOL_CMD=("${_TOOL_BIN}")
}

resolve_opencode2_paths() {
    # Host side: the opencode2-specific directories, derived from the resolved
    # $HOME (never from XDG_*), matching the ansible `opencode2` wrapper, which
    # exports XDG_*_HOME=$HOME/.{config,local/share,local/state,cache}/opencode2
    # (OpenCode 2 appends "opencode" to each).  They keep OpenCode 2 data apart
    # from OpenCode 1 on the host.
    OC2_CONFIG_SRC="${_HOME}/.config/opencode2/opencode"
    OC2_DATA_SRC="${_HOME}/.local/share/opencode2/opencode"
    OC2_CACHE_SRC="${_HOME}/.cache/opencode2/opencode"
    OC2_TUI_STATE_SRC="${_HOME}/.local/state/opencode2/opencode/latest/tui"

    # Sandbox side: always the standard locations, which is where OpenCode 2
    # looks by default, so no XDG_* override is needed.  The XDG_* values are
    # the ones the shared library resolved (the host's, or ~/.config etc.), the
    # same way bwopencode does.  State is ephemeral at the default location.
    OC2_CONFIG_DIR="${XDG_CONFIG_HOME}/opencode"
    OC2_DATA_DIR="${XDG_DATA_HOME}/opencode"
    OC2_CACHE_DIR="${XDG_CACHE_HOME}/opencode"
    OC2_STATE_DIR="${_HOME}/.local/state/opencode"
    OC2_TUI_STATE_DIR="${OC2_STATE_DIR}/latest/tui"

    # The opencode2 config directory holds service.json, which is never
    # mounted: refuse a working directory / --ro-path / --rw-path that would
    # bind it whole.
    # shellcheck disable=SC2034  # read by _bwrap_contains_blocked in the library
    EXTRA_BLOCKED_DIRS=("${OC2_CONFIG_SRC}")

    # The fixed paths cannot reach a blocked path unless $HOME itself does;
    # the checks mirror bwopencode and also catch symlinked directories.
    _check_dir_safe "${OC2_DATA_SRC}"  "opencode2 data dir"
    _check_dir_safe "${OC2_CACHE_SRC}" "opencode2 cache dir"
    _check_dir_safe "${OC2_TUI_STATE_SRC}" "opencode2 TUI state dir"
}

# Ensure writable directories exist on host.  The data dir is bound whole
# because the OpenCode 2 layout is not documented (database + -shm/-wal, log,
# repos, shell, ...), so no file list could be kept in sync.
ensure_host_dirs() {
    mkdir -p "${OC2_DATA_SRC}" "${OC2_CACHE_SRC}" "${OC2_TUI_STATE_SRC}"
}

# ── Database guard ───────────────────────────────────────────────
# Refuse to start when another host, or another OpenCode 2 build, is using the
# database; hold a lock for the life of the sandbox.  The lock is a file
# descriptor opened here: launch_sandbox ends in `exec`, which passes it on to
# bwrap and the sandboxed process, so it stays locked until they all exit.
# Not applied to commands that never open the database, to --exec (an
# arbitrary command) or to --dry-run.
guard_opencode2_db() {
    [[ "${DRY_RUN}" -eq 0 && -z "${TEST_CMD}" ]] || return 0

    local _lib="${SCRIPT_DIR}/../lib/opencode2-db-lock.sh"
    [[ -r "${_lib}" ]] || return 0
    # shellcheck source=../lib/opencode2-db-lock.sh
    source "${_lib}"
    oc2db_needs_guard ${TOOL_ARGS[@]+"${TOOL_ARGS[@]}"} || return 0

    # Only the installed binary has a known identity to compare running
    # processes with; the ansible wrapper script (fallback) does not.
    local _bin=""
    [[ "${_TOOL_BIN}" == "${OC2_INSTALL_BIN}" ]] && _bin="${_TOOL_BIN}"

    # shellcheck disable=SC2034  # read by oc2db_* in opencode2-db-lock.sh
    OC2DB_PROG=bwopencode2
    oc2db_guard "${OC2_DATA_SRC}" "${_bin}" || exit 1
}

# Resolve opencode2 config symlinks.
# We resolve each entry in the host config directory (OC2_CONFIG_SRC,
# ~/.config/opencode2/opencode/) so that symlinks pointing outside (e.g. into
# a dotfiles repo) are followed, and we bind the real file at the expected path
# under OC2_CONFIG_DIR, the standard location inside the sandbox.  This avoids exposing the dotfiles tree inside the sandbox.
#
# Every path is canonicalized with realpath (readlink -f) and the canonical
# result is passed through _check_path_safe before being added to
# OC2_CONFIG_BINDS.  This blocks symlinks that point into sensitive subtrees
# (e.g. config/creds -> ~/.aws/credentials) and, because ALL entries are
# canonicalized (not only symlinked ones), also a symlinked PARENT directory
# (~/.config/opencode2 -> ~/.aws): bwrap's --ro-bind follows the symlink, so
# the unresolved name alone would hide the real target.
resolve_config_symlinks() {
    OC2_CONFIG_BINDS=()
    [[ -d "${OC2_CONFIG_SRC}" ]] || return 0

    # The config directory itself may be (or sit under) a symlink.
    _bwrap_canonicalize_safe "${OC2_CONFIG_SRC}" "opencode2 config dir" root

    local entry local_resolved
    for entry in "${OC2_CONFIG_SRC}"/*; do
        [[ -e "${entry}" ]] || continue
        # service.json (or service-<hash>.json on other channels) holds the
        # background-service settings, including `service set env KEY VALUE`
        # values and the port.  The sandbox never runs the service, so the
        # file is not mounted.
        case "${entry##*/}" in
            service*.json) continue ;;
            # Authoring directories are mounted read-write by
            # build_opencode2_authoring_mounts; a read-only bind here would
            # shadow that.
            skills | agents | commands) continue ;;
        esac
        _bwrap_canonicalize_safe "${entry}" "opencode2 config entry '${entry}'"
        local_resolved="${_BWRAP_CANON}"
        OC2_CONFIG_BINDS+=("--ro-bind" "${local_resolved}" "${OC2_CONFIG_DIR}/${entry##*/}")
    done
}

# ── OpenCode 2 authoring directories (read-write, persistent) ────
# skills/, agents/ and commands/ under the OpenCode 2 config directory hold
# user-authored markdown definitions.  They are created on the host when
# missing and mounted read-write so the agent can create and edit them from
# inside the sandbox.  They live under the host config directory
# (OC2_CONFIG_SRC) and are mounted at the standard location (OC2_CONFIG_DIR).
# The Claude- and agent-compatible locations OpenCode
# also reads are mounted read-write only if they already exist.  Must run
# AFTER build_opencode2_config_mount (which creates the config directory).
build_opencode2_authoring_mounts() {
    build_authoring_dir_mounts_from skill   "${OC2_CONFIG_SRC}/skills"   "${OC2_CONFIG_DIR}/skills"
    build_authoring_dir_mounts_from agent   "${OC2_CONFIG_SRC}/agents"   "${OC2_CONFIG_DIR}/agents"
    build_authoring_dir_mounts_from command "${OC2_CONFIG_SRC}/commands" "${OC2_CONFIG_DIR}/commands"
    build_personal_authoring_mounts skill   "${_HOME}/.claude/skills" "${_HOME}/.agents/skills"
    build_personal_authoring_mounts agent   "${_HOME}/.claude/agents" "${_HOME}/.agents/agents"
    build_personal_authoring_mounts command "${_HOME}/.claude/commands"
}

# ── Managed OpenCode config (read-only, highest priority) ────────
# If a managed config exists at /etc/opencode/ on the host (deployed
# by ansible), bind-mount it RO into the sandbox.  OpenCode 2 reads
# managed settings from the same /etc/opencode path as OpenCode 1; it
# takes precedence over all other config sources and config in the
# project cannot override it.
#
# Both opencode.json and opencode.jsonc are mounted when present, so
# opencode2 can pick whichever format it prefers.  A managed
# /etc/opencode/AGENTS.md is mounted too when present (opencode.jsonc
# references it via "instructions").
#
# On hosts without /etc/opencode/, nothing is bound here — opencode2
# falls back to user config as usual.  A warning is emitted to stderr
# in that case so misconfigured managed hosts (e.g. ansible deployment
# failure) are noticed.
build_managed_config() {
    local _has_json=0 _has_jsonc=0
    [[ -f /etc/opencode/opencode.json  ]] && _has_json=1
    [[ -f /etc/opencode/opencode.jsonc ]] && _has_jsonc=1

    if [[ $((_has_json + _has_jsonc)) -gt 0   ]]; then
        # At least one host-managed config exists — bind whichever are present.
        BWRAP_ARGS+=(--dir /etc/opencode)
        if [[ "${_has_json}" -eq 1  ]]; then
            BWRAP_ARGS+=(--ro-bind /etc/opencode/opencode.json /etc/opencode/opencode.json)
        fi
        if [[ "${_has_jsonc}" -eq 1 ]]; then
            BWRAP_ARGS+=(--ro-bind /etc/opencode/opencode.jsonc /etc/opencode/opencode.jsonc)
        fi
        # Managed AGENTS.md, referenced from opencode.jsonc via "instructions".
        if [[ -f /etc/opencode/AGENTS.md ]]; then
            BWRAP_ARGS+=(--ro-bind /etc/opencode/AGENTS.md /etc/opencode/AGENTS.md)
        fi
    else
        printf 'bwopencode2: warning: no /etc/opencode/opencode.json{,c} found on host.\n' >&2
        printf '             Falling back to user config at %s/.\n' "${OC2_CONFIG_SRC}" >&2
    fi
}

# The host-managed skills alias may point into the shared skills tree
# (/nsls2/agents/skills).  Bind
# its resolved source at OpenCode's documented managed-skills location so the
# alias target and every supporting file remain available inside the sandbox.
build_managed_skills() {
    [[ -d /etc/opencode/skills && -r /etc/opencode/skills ]] || return 0
    BWRAP_ARGS+=(--dir /etc/opencode)
    build_managed_ro_bind /etc/opencode/skills /etc/opencode/skills
}

# OpenCode 2 also reads managed agents, commands, and plugins from
# /etc/opencode.  Bind each one read-only when it exists on the host.
build_managed_extras() {
    local _name
    for _name in agents commands plugins; do
        [[ -d "/etc/opencode/${_name}" && -r "/etc/opencode/${_name}" ]] || continue
        BWRAP_ARGS+=(--dir /etc/opencode)
        build_managed_ro_bind "/etc/opencode/${_name}" "/etc/opencode/${_name}"
    done
}

# ── Persistent .opencode/ directory ──────────────────────────────
# OpenCode creates .opencode/ inside the repo root for project-level
# config, rules, and plugins.  We store this in a persistent location
# outside the repo so it survives `git clean -xfd` on the host, and so
# repository-supplied .opencode/ content cannot inject config or plugins.
#
# The persistent directory is keyed by a hash of the bind dir path,
# stored on the host under ~/.local/share/opencode2/opencode/project-dotfiles/<hash>/.
# Inside the sandbox, this is bind-mounted on top of <repo>/.opencode/.
build_persistent_dotdir() {
    [[ -n "${_GIT_ROOT}" ]] || return 0

    local _repo_hash
    _repo_hash="$(printf '%s' "${_GIT_ROOT}" | sha256sum)"
    _repo_hash="${_repo_hash:0:16}"
    local _persist_dir="${OC2_DATA_SRC}/project-dotfiles/${_repo_hash}"
    # The host mkdir is skipped on --dry-run (no host-state changes); the
    # bind is still emitted so the printed command matches a real run.
    if [[ "${DRY_RUN}" -eq 0 ]]; then
        mkdir -p "${_persist_dir}"
    fi

    BWRAP_ARGS+=(
        --bind "${_persist_dir}" "${_GIT_ROOT}/.opencode"
    )
}

# ── OpenCode 2 config (read-only, symlinks resolved) ─────────────
build_opencode2_config_mount() {
    if [[ ${#OC2_CONFIG_BINDS[@]} -gt 0 ]]; then
        BWRAP_ARGS+=(
            --dir "${OC2_CONFIG_DIR}"
            "${OC2_CONFIG_BINDS[@]}"
        )
    fi
}

# ── OpenCode 2 data (read-write, whole directory) ────────────────
# Credentials live in opencode.db (the `credential` table), so persisting
# the data directory persists sign-in.  There is no tmpfs + selective
# persistence scheme (as in bwopencode) because the data layout is
# undocumented.
build_opencode2_data_mount() {
    BWRAP_ARGS+=(
        --bind "${OC2_DATA_SRC}" "${OC2_DATA_DIR}"
    )
}

# ── OpenCode 2 cache (read-write) ────────────────────────────────
# Provider npm packages are installed here, so it must be writable.
build_opencode2_cache_mount() {
    BWRAP_ARGS+=(
        --bind "${OC2_CACHE_SRC}" "${OC2_CACHE_DIR}"
    )
}

# ── OpenCode 2 state (ephemeral, TUI plugin storage persists) ────
# $HOME is a tmpfs, so state is discarded on exit; this avoids lock
# clashes on NFS homes (locks/) and sharing service files with a host
# opencode2.  Create the directory chain so OpenCode 2 can write into it
# without having to create parents.
#
# Only the TUI plugin storage directory is persisted: it holds the
# dismissed "Getting started" box and the tab layout, and is never locked.
# A directory is bound (not single files) because OpenCode writes a temp
# file and renames it over the target, which fails on a bind-mounted file.
# "latest" is the release channel directory name used by OpenCode 2; a
# different channel would use another name and not be persisted.
build_opencode2_state_dir() {
    BWRAP_ARGS+=(
        --dir "${OC2_STATE_DIR}"
        --bind "${OC2_TUI_STATE_SRC}" "${OC2_TUI_STATE_DIR}"
    )
}

# ── OpenCode env vars ────────────────────────────────────────────
# Pass through ONLY the allowlisted OPENCODE_* env vars (harmless behaviour
# switches).  Every other OPENCODE_* variable is dropped, because the
# OpenCode 2 binary reads several sensitive ones, e.g.:
#   OPENCODE_PASSWORD / OPENCODE_SERVER_PASSWORD  password of a v2 server;
#       with a route to it (the private network namespace normally gives
#       none) it would let the agent drive an UNSANDBOXED server (port
#       49374) and run tools outside
#   OPENCODE_SSH_ASKPASS_TOKEN / _PORT, OPENCODE_EDITOR_SSE_PORT,
#   OPENCODE_PTY_HANDOFF  host-side helper channels
#   OPENCODE_DB, OPENCODE_TEST_HOME, OPENCODE_CONFIG*, OPENCODE_MODELS_PATH/URL
#       redirect data/config/model sources outside the sandbox layout
#   OPENCODE_API_KEY  credentials
# Also pass through AIFAPIM_* env vars for NSLS-II Hermes gateway.
# AIFAPIM_TOKEN_FILE (the Entra ID token for the gateway, read by the aifapim-entra
# plugin) is passed through too; the token itself comes in with --n2c-token aifapim.
# With --github-tokens, also forward GH_TOKEN_* vars so the agent
# can authenticate gh(1) via per-command:
#   GH_TOKEN="$GH_TOKEN_NSLS2" gh <subcommand>
#
# ── OpenCode 2 install directory (read-only) ─────────────────────
# /usr/local/bin/opencode2 is a wrapper script (deployed by ansible) that runs
# /opt/nsls2/opencode2/node_modules/@opencode/cli/bin/opencode.exe, which
# use_opencode2_binary runs directly.  The
# sandbox mounts /usr but not /opt, so without this mount neither the binary
# nor the wrapper (--exec, fallback) can run it.  The
# path is fixed by the ansible base role.  Mounted read-only; nothing is bound
# when the directory is absent (for example a plain opencode2 elsewhere on PATH).
build_opencode2_install_mount() {
    if [[ -d /opt/nsls2/opencode2 ]]; then
        BWRAP_ARGS+=(
            --dir /opt/nsls2
            --ro-bind /opt/nsls2/opencode2 /opt/nsls2/opencode2
        )
        # Already covers the binary run by use_opencode2_binary, so
        # build_dynamic_tool_mounts must not bind its directory again.
        _MOUNTED_PREFIXES["/opt/nsls2/opencode2"]=1
    fi
}

# Must run AFTER build_env_vars.  No XDG_* override is set: OpenCode 2 finds
# its directories at the standard locations they are mounted at.
build_opencode2_env() {
    build_opentui_zellij_env

    # Allowlist of OPENCODE_* variables that may enter the sandbox.
    # Do NOT add anything that carries a secret, a port, a file path or a URL.
    local -a _OC2_ENV_ALLOWLIST=(
        OPENCODE_DISABLE_AUTOUPDATE
        OPENCODE_DISABLE_FILEWATCHER
        OPENCODE_FILEWATCHER_DISABLE
        OPENCODE_DISABLE_MODELS_FETCH
        OPENCODE_DISABLE_CLAUDE_CODE
        OPENCODE_DISABLE_CLAUDE_CODE_SKILLS
        OPENCODE_DISABLE_FFF
        OPENCODE_DISABLE_PROJECT_CONFIG
        OPENCODE_LOG_LEVEL
        OPENCODE_PRINT_LOGS
    )

    # AIFAPIM gateway config
    pass_through_if_set AIFAPIM_HOST
    # The API key is passed through unchanged; print_dry_run redacts the value
    # of any variable whose name looks secret (KEY/TOKEN/PASSWORD/...).
    pass_through_if_set AIFAPIM_API_KEY
    # Path of the gateway's Entra ID token file, for the aifapim-entra plugin. It is a path,
    # not the token; the file is mounted by --n2c-token aifapim. The plugin does nothing
    # unless this and AIFAPIM_HOST are both set.
    pass_through_if_set AIFAPIM_TOKEN_FILE

    local _key _allowed _name
    local -a _dropped=()
    while IFS= read -r _key; do
        [[ "${_key}" == OPENCODE_* ]] || continue
        _allowed=0
        for _name in "${_OC2_ENV_ALLOWLIST[@]}"; do
            if [[ "${_key}" == "${_name}" ]]; then
                _allowed=1
                break
            fi
        done
        if [[ "${_allowed}" -eq 1 ]]; then
            SANDBOX_ENV+=("${_key}=${!_key}")
        else
            _dropped+=("${_key}")
        fi
    done < <(compgen -e)

    # Names only, never values.
    if [[ "${DRY_RUN}" -eq 1 && ${#_dropped[@]} -gt 0 ]]; then
        printf 'bwopencode2: dry-run: dropped host OPENCODE_* variables (not in allowlist): %s\n' "${_dropped[*]}" >&2
    fi

    # --serve: the password of the server this sandbox itself runs.  It is set
    # here, after the host variables were dropped above, so it is the only
    # OPENCODE_PASSWORD the sandbox sees and never one of the host's.
    if [[ "${SERVE}" -eq 1 ]]; then
        SANDBOX_ENV+=("OPENCODE_PASSWORD=${SERVE_PASSWORD}")
    fi

    # GitHub CLI token passthrough (opt-in via --github-tokens).  In
    # --dry-run, print_dry_run redacts the values (the names match *TOKEN*).
    if [[ "${FORWARD_GH_TOKENS}" -eq 1 ]]; then
        forward_env_by_prefix GH_TOKEN_
    fi
}

# ── Sandbox context ──────────────────────────────────────────────
# Mount the context file (see build_sandbox_context) and make OpenCode 2 load
# it.  OPENCODE_CONFIG_CONTENT is an inline config layered over the user's:
# its "instructions" list is added to theirs, not substituted for it.  Any
# host OPENCODE_CONFIG_CONTENT is dropped by build_opencode2_env, so this is
# the only value the sandbox sees.  Must run after build_opencode2_env.
build_opencode2_context() {
    # shellcheck disable=SC2034  # consumed by sourced bwrap_sandbox_lib.sh
    SANDBOX_CONTEXT_NOTES=(
        "Only run \`opencode2\` with \`--standalone\`. Without it the CLI talks to a shared background service (port 49374) that runs tools OUTSIDE this sandbox."
        "Plan mode writes plan files to \`~/.opencode/plan/\`, which is not mounted: they are lost at exit unless the plan-mirror plugin keeps them."
    )
    if [[ "${SERVE}" -eq 1 ]]; then
        SANDBOX_CONTEXT_NOTES+=(
            "This session is a sandboxed \`opencode2 serve\` (the OpenCode web UI) on port ${SERVE_PORT}, started by \`bwopencode2 --serve\`; the user reaches it through the published port. Do not start or connect to any other OpenCode server."
        )
    fi
    build_sandbox_context bwopencode2
    [[ -n "${SANDBOX_CONTEXT_PATH}" && -z "${TEST_CMD}" ]] || return 0

    local _path_json
    if ! _path_json="$(_bwrap_json_quote "${SANDBOX_CONTEXT_PATH}")"; then
        echo "Warning: bwopencode2: cannot pass the sandbox context file to OpenCode (unusual characters in the path)." >&2
        return 0
    fi
    SANDBOX_ENV+=("OPENCODE_CONFIG_CONTENT={\"instructions\":[${_path_json}]}")
}

# ═══════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════

main() {
    bwrap_check_account
    parse_wrapper_args "$@"

    if [[ "${SHOW_HELP}" -eq 1 ]]; then
        show_help
        # show_help never returns
    fi

    serve_parse_range
    if [[ "${SERVE_SSH_CONFIG}" -eq 1 ]]; then
        serve_print_ssh_config
        exit 0
    fi
    serve_check_args

    bwrap_resolve_tool opencode2 "OpenCode 2 is installed by the ansible base role."
    use_opencode2_binary

    # --exec runs an arbitrary command, so its arguments are not opencode2's.
    # --serve builds its own arguments (serve_prepare), so the guard, which
    # refuses `serve`, does not apply to them.
    if [[ -z "${TEST_CMD}" && "${SERVE}" -eq 0 ]]; then
        guard_tool_args
    fi

    detect_kernel_capabilities
    resolve_common_paths
    resolve_opencode2_paths
    # --serve adds its port to --publish, so it comes before the network
    # backend is chosen.
    if [[ "${SERVE}" -eq 1 ]]; then
        serve_prepare
    fi
    detect_net_capabilities
    # Fail before any host-state change (ensure_host_dirs) if nothing is configured.
    require_opencode_config bwopencode2 "${OC2_CONFIG_SRC}"
    detect_shell
    # Skip host-state mutations on dry-run so --dry-run remains side-effect-free.
    if [[ "${DRY_RUN}" -eq 0 ]]; then
        ensure_host_dirs
    fi
    guard_opencode2_db
    parse_all_git_includes
    resolve_config_symlinks
    init_sandbox_path

    # Build bwrap argument list
    build_base_sandbox
    build_proc_dev_tmp
    build_sys_mounts
    build_etc_mounts
    build_net_isolation
    build_managed_config
    build_managed_skills
    build_managed_extras
    build_home_tmpfs
    build_workdir_mount
    build_persistent_dotdir
    build_opencode2_config_mount
    build_opencode2_authoring_mounts
    build_opencode2_data_mount
    build_opencode2_cache_mount
    build_opencode2_state_dir
    build_git_mounts
    build_pixi_mounts
    build_ccache_mounts
    build_npm_mounts
    build_user_bin_mount
    build_nsls2_mount
    build_opencode2_install_mount
    build_dynamic_tool_mounts
    build_n2c_token_mounts
    build_extra_path_mounts

    # Environment variables
    build_env_vars
    build_opencode2_env
    build_opencode2_context

    # Mask dangerous binaries as the very last step: a mask is hidden by any
    # later bind that covers it (e.g. --ro-path /usr or /usr/bin).
    build_binary_masks

    # Launch
    if [[ "${SERVE}" -eq 1 ]]; then
        serve_print_info
    fi
    if [[ "${DRY_RUN}" -eq 1 ]]; then
        print_dry_run
    else
        launch_sandbox
    fi
}

main "$@"
