#!/usr/bin/env bash
# bwopencode — Launch opencode inside a bubblewrap (bwrap) sandbox.
#
# Requires: bwrap >= 0.4.0 (RHEL 8)
#   - 0.4.0: base functionality
#   - 0.6.3+: bind over ro-bind (fallback: skip binary masking)
#
# The sandbox provides filesystem isolation:
#   - Current directory: read-write
#   - OpenCode config: read-only (symlinks resolved)
#   - Personal skills (~/.config/opencode/skills, ~/.claude/skills,
#     ~/.agents/skills): read-write (if present); each skill is resolved
#     individually, so skills symlinked in from elsewhere (e.g. a shared
#     skills repository) work too
#   - OpenCode data dir: ephemeral tmpfs with selective persistence
#       - auth.json: persisted only if it already exists on host;
#         otherwise created in tmpfs (discarded on exit)
#       - Database, logs, plans, snapshots, storage, tool-output,
#         project-dotfiles: always persisted
#   - OpenCode cache: read-write
#   - Git config + includes: read-only
#   - Pixi cache: read-write
#   - Pixi config: read-only
#   - ccache config: read-only
#   - ccache cache: read-write
#   - npm config: read-only
#   - npm cache: read-write
#   - System and user binaries: read-only
#   - SSH binaries: masked (ssh, scp, sftp, ssh-agent, etc.)
#   - Network tools: masked (telnet, nc/ncat, socat, rsync, rsh)
#   - Kerberos tools: masked (kinit, klist, kdestroy, kswitch)
#   - Privilege escalation: masked (sudo, su, pkexec)
#   - Namespace tools: masked (nsenter, unshare, chroot)
#   - Keyring tools: masked (keyctl)
#   - SSH/GPG agent env vars: stripped
#   - ~/.bashrc and other shell rc files: not mounted
#
# Usage:
#   bwopencode [bwopencode-options] [opencode arguments...]
#   bwopencode --help
#
# Options:
#   --help, -h      Show this help (wrapper options + opencode's own help).
#   --dry-run       Print the bwrap command that would be executed without running it.
#   --exec CMD      Run CMD inside the sandbox instead of opencode.
#                   Useful for running one-off commands, scripts, or diagnostic tools
#                   inside the fully-configured sandbox environment.
#   --init-auth     Create auth.json on the host so that GitHub OAuth tokens
#                   persist across sessions.  Only needed once per account;
#                   after that auth.json exists and is automatically persisted.
#                   On shared accounts, do NOT use this flag — tokens will be
#                   ephemeral by default (created in tmpfs, discarded on exit).
#   --new-session   Force bwrap --new-session even on kernels with the TIOCSTI cap
#                   guard.  Detaches the controlling tty for stricter isolation at the
#                   cost of SIGWINCH (terminal resize) propagation.
#   --ro-path PATH  Mount PATH read-only into the sandbox.  May be repeated to
#                   accumulate multiple paths.  Dangerous paths are blocked:
#                   $HOME and ancestors, ~/.ssh, ~/.gnupg, ~/.aws, ~/.kube,
#                   ~/.docker, ~/.netrc, ~/.pypirc, ~/.rattler, ~/.yarnrc,
#                   ~/.yarnrc.yml, ~/.yarn, ~/.config/gh,
#                   $XDG_DATA_HOME/uv/credentials, /root, /etc/shadow,
#                   /etc/sudoers{,.d}.
#   --rw-path PATH  Mount PATH read-write into the sandbox.  May be repeated to
#                   accumulate multiple paths.  Same blocked-path rules as --ro-path.
#                   A nested --ro-path/--rw-path overrides the one it sits under,
#                   so `--rw-path DIR --ro-path DIR/sub` protects DIR/sub.

set -euo pipefail

# Source the shared sandbox library.
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../lib/bwrap_sandbox_lib.sh
source "${SCRIPT_DIR}/../lib/bwrap_sandbox_lib.sh"

# ═══════════════════════════════════════════════════════════════════
# Tool-specific state
# ═══════════════════════════════════════════════════════════════════

INIT_AUTH=0
FORWARD_GH_TOKENS=0
OC_CONFIG_BINDS=()

# ═══════════════════════════════════════════════════════════════════
# Tool-specific functions
# ═══════════════════════════════════════════════════════════════════

parse_wrapper_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help | -h)
                SHOW_HELP=1
                shift
                ;;
            --dry-run)
                DRY_RUN=1
                shift
                ;;
            --exec)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --exec requires a command argument." >&2
                    exit 1
                fi
                # shellcheck disable=SC2034  # read by bwrap_resolve_tool in the library
                TEST_CMD="$2"
                shift 2
                ;;
            --init-auth)
                INIT_AUTH=1
                shift
                ;;
            --github-tokens)
                FORWARD_GH_TOKENS=1
                shift
                ;;
            --new-session)
                # shellcheck disable=SC2034  # consumed by sourced bwrap_sandbox_lib.sh (sandboxed_exec)
                FORCE_NEW_SESSION=1
                shift
                ;;
            --ro-path)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --ro-path requires a path argument." >&2
                    exit 1
                fi
                EXTRA_RO_PATHS+=("$2")
                shift 2
                ;;
            --rw-path)
                if [[ $# -lt 2 ]]; then
                    echo "Error: --rw-path requires a path argument." >&2
                    exit 1
                fi
                EXTRA_RW_PATHS+=("$2")
                shift 2
                ;;
            *)
                break
                ;;
        esac
    done
    # shellcheck disable=SC2034  # consumed by library's print_dry_run/launch_sandbox
    TOOL_ARGS=("$@")
}

# Find the absolute path to the opencode binary on the host so we do
# not depend on PATH lookup inside the sandbox.
# Sets globals: _TOOL_BIN, _TOOL_CMD
show_help() {
    cat << 'HELP_EOF'
bwopencode — opencode inside a bubblewrap sandbox

Wrapper options (consumed before opencode sees the command line):
  -h, --help      Show this message followed by opencode's own help.
  --dry-run       Print the bwrap command that would be run, then exit.
  --exec CMD      Run CMD inside the fully-configured sandbox instead of opencode.
                  Use this to run scripts, diagnostic tools, or any command with
                  the same filesystem isolation and environment as opencode itself.
                  Example: bwopencode --exec bash
                           bwopencode --exec bash -c 'env | sort'
                  CMD itself is split on whitespace; pass arguments that need
                  quoting as separate words after it, as above.
  --init-auth     Create auth.json on the host so GitHub OAuth tokens persist
                  across sessions.  Run once on a personal account; skip on
                  shared accounts (tokens will be ephemeral by default).
  --new-session   Force bwrap to call setsid(2), detaching the sandbox from the
                  controlling terminal.  This is the default on older kernels
                  (< 5.14); on newer kernels we omit it so that SIGWINCH (terminal
                  resize) propagates from tmux/screen.  Use this flag to opt back
                  into stricter terminal isolation when SIGWINCH is not important.
  --ro-path PATH  Mount PATH (file or directory) read-only into the sandbox.
                  May be repeated to accumulate multiple extra paths.
                  Blocked: $HOME and ancestors, ~/.ssh, ~/.gnupg, ~/.aws,
                  ~/.kube, ~/.docker, ~/.netrc, ~/.pypirc, ~/.rattler,
                  ~/.yarnrc, ~/.yarnrc.yml, ~/.yarn, ~/.config/gh,
                  $XDG_DATA_HOME/uv/credentials, /root, /etc/shadow,
                  /etc/sudoers{,.d}.
                  Symlinks are resolved before the safety check is applied.
  --rw-path PATH  Mount PATH (file or directory) read-write into the sandbox.
                  Same blocked-path rules as --ro-path.  May be repeated.
                  --ro-path/--rw-path may nest: a nested path overrides the one
                  it sits under, so `--rw-path DIR --ro-path DIR/sub` keeps DIR
                  writable but DIR/sub read-only.
  --github-tokens Forward any GH_TOKEN_* environment variables into the
                  sandbox so the agent can authenticate the gh(1) CLI.
                  Off by default.  When set, use per-command token selection:
                    GH_TOKEN="$GH_TOKEN_NSLS2" gh pr list -R NSLS2/repo
                    GH_TOKEN="$GH_TOKEN_PERSONAL" gh issue list -R user/repo

All other arguments are passed through to opencode unchanged.

HELP_EOF
    # Delegate to opencode --help inside the sandbox so the user sees the full
    # opencode option set in the same invocation.  We re-exec this script with
    # --exec so the sandbox is fully constructed; opencode --help is passed
    # as the sandbox command.
    bwrap_show_tool_help opencode
}

resolve_opencode_paths() {
    OC_CONFIG_DIR="${XDG_CONFIG_HOME}/opencode"
    OC_DATA_DIR="${XDG_DATA_HOME}/opencode"
    OC_CACHE_DIR="${XDG_CACHE_HOME}/opencode"
    OC_AUTH_FILE="${OC_DATA_DIR}/auth.json"

    # Validate the user-controllable root directories once here so that all
    # sub-path mounts derived from them are implicitly covered.
    # XDG_CONFIG_HOME, XDG_DATA_HOME, and XDG_CACHE_HOME are already checked
    # in resolve_common_paths; checking the opencode subdirs covers the case
    # where someone has set those XDG vars to a parent of a blocked path and
    # 'opencode' happens to be a path component that lands inside the block.
    _check_dir_safe "${OC_DATA_DIR}"   "XDG_DATA_HOME (opencode data)"
    _check_dir_safe "${OC_CACHE_DIR}"  "XDG_CACHE_HOME (opencode cache)"
}

# Ensure writable directories and files exist on host.
ensure_host_dirs() {
    mkdir -p "${OC_DATA_DIR}" "${OC_CACHE_DIR}" \
        "${OC_DATA_DIR}/log" \
        "${OC_DATA_DIR}/plans" \
        "${OC_DATA_DIR}/project-dotfiles" \
        "${OC_DATA_DIR}/snapshot" \
        "${OC_DATA_DIR}/storage" \
        "${OC_DATA_DIR}/tool-output"

    # SQLite database files.  touch is safe: SQLite initialises an empty
    # .db file on first open, and recreates empty -shm/-wal files as part
    # of normal WAL-mode operation.
    touch "${OC_DATA_DIR}/opencode.db" \
          "${OC_DATA_DIR}/opencode.db-shm" \
          "${OC_DATA_DIR}/opencode.db-wal"
}

# Resolve opencode config symlinks.
# We resolve each entry in ~/.config/opencode/ so that symlinks
# pointing outside (e.g. into a dotfiles repo) are followed, and we
# bind the real file at the expected path.  This avoids exposing the
# dotfiles tree inside the sandbox.
#
# Every path is canonicalized with realpath (readlink -f) and the canonical
# result is passed through _check_path_safe before being added to
# OC_CONFIG_BINDS.  This blocks symlinks that point into sensitive subtrees
# (e.g. ~/.config/opencode/creds -> ~/.aws/credentials) and, because ALL
# entries are canonicalized (not only symlinked ones), also a symlinked
# PARENT directory (~/.config/opencode -> ~/.aws): bwrap's --ro-bind follows
# the symlink, so the unresolved name alone would hide the real target.
resolve_config_symlinks() {
    OC_CONFIG_BINDS=()
    [[ -d "${OC_CONFIG_DIR}" ]] || return 0

    # The config directory itself may be (or sit under) a symlink.
    _bwrap_canonicalize_safe "${OC_CONFIG_DIR}" "opencode config dir"

    local entry local_resolved
    for entry in "${OC_CONFIG_DIR}"/*; do
        [[ -e "${entry}" ]] || continue
        # Personal skills are mounted by build_personal_skills_mounts, one
        # skill at a time, so symlinked skills resolve in the sandbox.
        [[ "${entry##*/}" == skills ]] && continue
        _bwrap_canonicalize_safe "${entry}" "opencode config entry '${entry}'"
        local_resolved="${_BWRAP_CANON}"
        OC_CONFIG_BINDS+=("--ro-bind" "${local_resolved}" "${entry}")
    done
}

# ── Managed OpenCode config and skills (read-only, highest priority) ─
# If a managed config exists at /etc/opencode/ on the host (deployed
# by ansible), bind-mount it RO into the sandbox.  This is the Linux
# managed-settings path and takes precedence over all other config
# sources; config in the project cannot override it.
#
# Both opencode.json and opencode.jsonc are mounted when present, so
# opencode can pick whichever format it prefers.
#
# On hosts without /etc/opencode/, nothing is bound here — opencode
# falls back to user config at ~/.config/opencode/ as usual.  A
# warning is emitted to stderr in that case so misconfigured managed
# hosts (e.g. ansible deployment failure) are noticed.
build_managed_config() {
    local _has_json=0 _has_jsonc=0
    [[ -f /etc/opencode/opencode.json  ]] && _has_json=1
    [[ -f /etc/opencode/opencode.jsonc ]] && _has_jsonc=1

    if [[ $((_has_json + _has_jsonc)) -gt 0   ]]; then
        # At least one host-managed config exists — bind whichever are present.
        BWRAP_ARGS+=(--dir /etc/opencode)
        if [[ "${_has_json}" -eq 1  ]]; then
            BWRAP_ARGS+=(--ro-bind /etc/opencode/opencode.json /etc/opencode/opencode.json)
        fi
        if [[ "${_has_jsonc}" -eq 1 ]]; then
            BWRAP_ARGS+=(--ro-bind /etc/opencode/opencode.jsonc /etc/opencode/opencode.jsonc)
        fi
    else
        printf 'bwopencode: warning: no /etc/opencode/opencode.json{,c} found on host.\n' >&2
        printf '            Falling back to user config at ~/.config/opencode/.\n' >&2
    fi
}

# The host-managed skills alias may point into /opt/nsls2/skills.  Bind
# its resolved source at OpenCode's documented managed-skills location so the
# alias target and every supporting file remain available inside the sandbox.
build_managed_skills() {
    [[ -d /etc/opencode/skills && -r /etc/opencode/skills ]] || return 0
    BWRAP_ARGS+=(--dir /etc/opencode)
    build_managed_ro_bind /etc/opencode/skills /etc/opencode/skills
}

# ── Persistent .opencode/ directory ──────────────────────────────
# OpenCode creates .opencode/ inside the repo root for project-level
# config, rules, and plugins.  We store this in a persistent location
# outside the repo so it survives `git clean -xfd` on the host.
#
# The persistent directory is keyed by a hash of the bind dir path,
# stored under $XDG_DATA_HOME/opencode/project-dotfiles/<hash>/.
# Inside the sandbox, this is bind-mounted on top of <repo>/.opencode/.
build_persistent_dotdir() {
    [[ -n "${_GIT_ROOT}" ]] || return 0

    local _repo_hash
    _repo_hash="$(printf '%s' "${_GIT_ROOT}" | sha256sum)"
    _repo_hash="${_repo_hash:0:16}"
    local _persist_dir="${OC_DATA_DIR}/project-dotfiles/${_repo_hash}"
    # The host mkdir is skipped on --dry-run (no host-state changes); the
    # bind is still emitted so the printed command matches a real run.
    if [[ "${DRY_RUN}" -eq 0 ]]; then
        mkdir -p "${_persist_dir}"
    fi

    BWRAP_ARGS+=(
        --bind "${_persist_dir}" "${_GIT_ROOT}/.opencode"
    )
}

# ── OpenCode config (read-only, symlinks resolved) ───────────────
build_opencode_config_mount() {
    if [[ ${#OC_CONFIG_BINDS[@]} -gt 0 ]]; then
        BWRAP_ARGS+=(
            --dir "${OC_CONFIG_DIR}"
            "${OC_CONFIG_BINDS[@]}"
        )
    fi
}

# ── OpenCode data (ephemeral tmpfs + selective persistence) ──────
# Mount the data dir as ephemeral tmpfs, then selectively bind-mount
# the files and directories that must persist across sessions.
#
# auth.json is only bind-mounted if it already exists on the host.
# If absent, opencode creates it inside the tmpfs — the token is
# usable for the session but discarded on exit.  This is the desired
# behaviour for shared accounts.  On a personal account, run with
# --init-auth once to create the file and bootstrap persistent auth.
#
# Any files NOT in the persist list (e.g. mcp-auth.json)
# will be writable inside the sandbox but discarded on exit.
build_opencode_data_mounts() {
    BWRAP_ARGS+=(
        --tmpfs "${OC_DATA_DIR}"
    )

    # Persistent directories
    local _subdir
    for _subdir in log plans project-dotfiles snapshot storage tool-output; do
        BWRAP_ARGS+=(--bind "${OC_DATA_DIR}/${_subdir}" "${OC_DATA_DIR}/${_subdir}")
    done

    # Persistent files
    local _file
    for _file in opencode.db opencode.db-shm opencode.db-wal; do
        BWRAP_ARGS+=(--bind "${OC_DATA_DIR}/${_file}" "${OC_DATA_DIR}/${_file}")
    done

    # auth.json: only persist if it already exists on the host.
    # Use --init-auth on first run to bootstrap persistent auth.
    # File creation is skipped on --dry-run to keep that mode side-effect-free.
    if [[ "${INIT_AUTH}" -eq 1 ]] && [[ ! -f "${OC_AUTH_FILE}" ]]; then
        if [[ "${DRY_RUN}" -eq 0 ]]; then
            # Use umask to ensure file is created with 0600 permissions atomically
            ( umask 077 && printf '{}\n' > "${OC_AUTH_FILE}" )
            echo "Created ${OC_AUTH_FILE} — auth tokens will persist after this session." >&2
        fi
    fi
    if _persist_bind_wanted "${OC_AUTH_FILE}"; then
        BWRAP_ARGS+=(--bind "${OC_AUTH_FILE}" "${OC_AUTH_FILE}")
    fi
}

# ── OpenCode cache (read-write) ──────────────────────────────────
build_opencode_cache_mount() {
    BWRAP_ARGS+=(
        --bind "${OC_CACHE_DIR}" "${OC_CACHE_DIR}"
    )
}

# ── OpenCode env vars ────────────────────────────────────────────
# Pass through an ALLOWLIST of harmless OPENCODE_* behaviour toggles, and
# AIFAPIM_* env vars for the NSLS-II Hermes gateway.  Other host OPENCODE_*
# variables are dropped: some are secrets (OPENCODE_SERVER_PASSWORD would
# let the agent, which shares the host network, drive an unsandboxed
# opencode server) and others redirect config/data/DB/model/server locations
# or inject config (OPENCODE_CONFIG*, OPENCODE_PERMISSION) and so would
# bypass the managed config.  In --dry-run the NAMES (never values) of
# dropped variables are printed to stderr.
#
# Names were enumerated from the installed opencode v1 binary
# (strings of OPENCODE_*) and the docs env-var table.  Add a name here only
# if it is a pure on/off or numeric tuning toggle: never anything with
# PASSWORD, TOKEN, SECRET, KEY, URL, PORT, SERVER, DB, HOME, CONFIG, PATH or
# a *_CONTENT payload.
_OPENCODE_ENV_ALLOWLIST=(
    OPENCODE_ALWAYS_NOTIFY_UPDATE
    OPENCODE_DISABLE_AUTOCOMPACT
    OPENCODE_DISABLE_AUTOUPDATE
    OPENCODE_DISABLE_CLAUDE_CODE
    OPENCODE_DISABLE_CLAUDE_CODE_PROMPT
    OPENCODE_DISABLE_CLAUDE_CODE_SKILLS
    OPENCODE_DISABLE_DEFAULT_PLUGINS
    OPENCODE_DISABLE_EMBEDDED_WEB_UI
    OPENCODE_DISABLE_EXTERNAL_SKILLS
    OPENCODE_DISABLE_FFF
    OPENCODE_DISABLE_LSP_DOWNLOAD
    OPENCODE_DISABLE_MODELS_FETCH
    OPENCODE_DISABLE_MOUSE
    OPENCODE_DISABLE_PROJECT_CONFIG
    OPENCODE_DISABLE_PRUNE
    OPENCODE_DISABLE_TERMINAL_TITLE
    OPENCODE_ENABLE_EXA
    OPENCODE_ENABLE_EXPERIMENTAL_MODELS
    OPENCODE_ENABLE_PARALLEL
    OPENCODE_ENABLE_QUESTION_TOOL
    OPENCODE_EXPERIMENTAL
    OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS
    OPENCODE_EXPERIMENTAL_BASH_DEFAULT_TIMEOUT_MS
    OPENCODE_EXPERIMENTAL_CODE_MODE
    OPENCODE_EXPERIMENTAL_DISABLE_COPY_ON_SELECT
    OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER
    OPENCODE_EXPERIMENTAL_EVENT_SYSTEM
    OPENCODE_EXPERIMENTAL_EXA
    OPENCODE_EXPERIMENTAL_FILEWATCHER
    OPENCODE_EXPERIMENTAL_ICON_DISCOVERY
    OPENCODE_EXPERIMENTAL_LSP_TOOL
    OPENCODE_EXPERIMENTAL_LSP_TY
    OPENCODE_EXPERIMENTAL_NATIVE_LLM
    OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX
    OPENCODE_EXPERIMENTAL_OXFMT
    OPENCODE_EXPERIMENTAL_PARALLEL
    OPENCODE_EXPERIMENTAL_PLAN_MODE
    OPENCODE_EXPERIMENTAL_REFERENCES
    OPENCODE_EXPERIMENTAL_SCOUT
    OPENCODE_EXPERIMENTAL_WEBSOCKETS
    OPENCODE_EXPERIMENTAL_WORKSPACES
    OPENCODE_FAST_BOOT
    OPENCODE_LOG_LEVEL
    OPENCODE_PRINT_LOGS
    OPENCODE_PURE
    OPENCODE_SHOW_TTFD
)

# With --github-tokens, also forward GH_TOKEN_* vars so the agent
# can authenticate gh(1) via per-command:
#   GH_TOKEN="$GH_TOKEN_NSLS2" gh <subcommand>
build_opencode_env() {
    # AIFAPIM gateway config
    pass_through_if_set AIFAPIM_HOST
    pass_through_if_set AIFAPIM_API_KEY

    local _key _allowed _ok
    local _dropped=()
    while IFS= read -r _key; do
        if [[ "${_key}" == OPENCODE_* ]]; then
            _ok=0
            for _allowed in "${_OPENCODE_ENV_ALLOWLIST[@]}"; do
                if [[ "${_key}" == "${_allowed}" ]]; then
                    _ok=1
                    break
                fi
            done
            if [[ "${_ok}" -eq 1 ]]; then
                SANDBOX_ENV+=("${_key}=${!_key}")
            else
                _dropped+=("${_key}")
            fi
        fi
    done < <(compgen -e)

    if [[ "${DRY_RUN}" -eq 1 && ${#_dropped[@]} -gt 0 ]]; then
        echo "Note: dropped OPENCODE_* env vars not on the allowlist (names only): ${_dropped[*]}" >&2
    fi

    # GitHub CLI token passthrough (opt-in via --github-tokens).  In
    # --dry-run, print_dry_run redacts the values (the names match *TOKEN*).
    if [[ "${FORWARD_GH_TOKENS}" -eq 1 ]]; then
        forward_env_by_prefix GH_TOKEN_
    fi
}

# ═══════════════════════════════════════════════════════════════════
# Main
# ═══════════════════════════════════════════════════════════════════

main() {
    bwrap_check_account
    parse_wrapper_args "$@"

    if [[ "${SHOW_HELP}" -eq 1 ]]; then
        show_help
        # show_help never returns
    fi

    bwrap_resolve_tool opencode

    detect_bwrap_capabilities
    detect_kernel_capabilities
    resolve_common_paths
    resolve_opencode_paths
    detect_shell
    # Skip host-state mutations on dry-run so --dry-run remains side-effect-free.
    if [[ "${DRY_RUN}" -eq 0 ]]; then
        ensure_host_dirs
    fi
    parse_all_git_includes
    resolve_config_symlinks
    init_sandbox_path

    # Build bwrap argument list
    build_base_sandbox
    build_binary_masks
    build_proc_dev_tmp
    build_sys_mounts
    build_etc_mounts
    build_managed_config
    build_managed_skills
    build_home_tmpfs
    build_workdir_mount
    build_persistent_dotdir
    build_opencode_config_mount
    build_personal_skills_mounts "${OC_CONFIG_DIR}/skills" "${_HOME}/.claude/skills" "${_HOME}/.agents/skills"
    build_opencode_data_mounts
    build_opencode_cache_mount
    build_git_mounts
    build_pixi_mounts
    build_ccache_mounts
    build_npm_mounts
    build_user_bin_mount
    build_nsls2_mount
    build_dynamic_tool_mounts
    build_extra_path_mounts

    # Environment variables
    build_env_vars
    build_opencode_env

    # Launch
    if [[ "${DRY_RUN}" -eq 1 ]]; then
        print_dry_run
    else
        launch_sandbox
    fi
}

main "$@"
